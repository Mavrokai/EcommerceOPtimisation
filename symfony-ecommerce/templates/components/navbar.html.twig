<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchToggle = document.querySelector('.search-toggle');
    const searchBar = document.getElementById('searchBar');
    
    if (searchToggle && searchBar) {
        searchToggle.addEventListener('click', function() {
            searchBar.classList.toggle('active');
            if (searchBar.classList.contains('active')) {
                searchBar.querySelector('.search-input').focus();
            }
        });
    }
    
    // Menu-burger pour mobile
    const mobileToggle = document.getElementById('mobileMenuToggle');
    const navbarMenu = document.getElementById('navbarMenu');
    
    if (mobileToggle && navbarMenu) {
        mobileToggle.addEventListener('click', function() {
            navbarMenu.classList.toggle('active');
            
            // Animation du hamburger
            const lines = this.querySelectorAll('.hamburger-line');
            if (navbarMenu.classList.contains('active')) {
                lines[0].style.transform = 'rotate(45deg) translate(5px, 5px)';
                lines[1].style.opacity = '0';
                lines[2].style.transform = 'rotate(-45deg) translate(7px, -6px)';
            } else {
                lines[0].style.transform = 'none';
                lines[1].style.opacity = '1';
                lines[2].style.transform = 'none';
            }
        });
        
        // Fermer le menu mobile en cliquant ailleurs
        document.addEventListener('click', function(e) {
            if (!mobileToggle.contains(e.target) && !navbarMenu.contains(e.target)) {
                navbarMenu.classList.remove('active');
                const lines = mobileToggle.querySelectorAll('.hamburger-line');
                lines[0].style.transform = 'none';
                lines[1].style.opacity = '1';
                lines[2].style.transform = 'none';
            }
        });
        
        // Gestion des dropdowns sur mobile
        const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
        dropdownToggles.forEach(toggle => {
            toggle.addEventListener('click', function(e) {
                if (window.innerWidth <= 992) {
                    e.preventDefault();
                    const dropdown = this.closest('.nav-dropdown');
                    const isOpen = dropdown.classList.contains('mobile-open');
                    
                    // Fermer tous les autres dropdowns
                    document.querySelectorAll('.nav-dropdown').forEach(d => {
                        d.classList.remove('mobile-open');
                    });
                    
                    // Basculer l'état du dropdown actuel
                    if (!isOpen) {
                        dropdown.classList.add('mobile-open');
                    }
                }
            });
        });
    }

    // Dropdown gestion pour tous les dropdowns avec gestion hover et clavier
    const dropdowns = document.querySelectorAll('.nav-dropdown');
    
    dropdowns.forEach(dropdown => {
        const dropdownToggle = dropdown.querySelector('.dropdown-toggle');
        const dropdownMenu = dropdown.querySelector('.dropdown-menu');
        
        if (dropdownToggle && dropdownMenu) {
            // Fonction centralisée qui synchronise classe CSS + aria-expanded
            function setDropdownOpen(open) {
                dropdownMenu.classList.toggle('show', open);
                dropdownToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            // Hover souris
            dropdown.addEventListener('mouseenter', function() { setDropdownOpen(true); });
            dropdown.addEventListener('mouseleave', function() { setDropdownOpen(false); });

            // Clic et touches clavier (Enter, Espace)
            dropdownToggle.addEventListener('click', function(e) {
                e.preventDefault();
                const isOpen = dropdownMenu.classList.contains('show');
                setDropdownOpen(!isOpen);
            });

            dropdownToggle.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    const isOpen = dropdownMenu.classList.contains('show');
                    setDropdownOpen(!isOpen);
                }
            });

            // Fermer si clic en dehors
            document.addEventListener('click', function(e) {
                if (!dropdown.contains(e.target)) {
                    setDropdownOpen(false);
                }
            });

            // Fermer avec Échap et remettre le focus sur le bouton (WCAG 2.1.2)
            dropdownMenu.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    setDropdownOpen(false);
                    dropdownToggle.focus();
                }

                // Focus trap : Tab/Shift+Tab reste dans le dropdown tant qu'il est ouvert
                if (e.key === 'Tab' && dropdownMenu.classList.contains('show')) {
                    const focusableItems = Array.from(
                        dropdownMenu.querySelectorAll('a[href], button:not([disabled])')
                    );
                    const first = focusableItems[0];
                    const last = focusableItems[focusableItems.length - 1];

                    if (e.shiftKey && document.activeElement === first) {
                        e.preventDefault();
                        dropdownToggle.focus();
                        setDropdownOpen(false);
                    } else if (!e.shiftKey && document.activeElement === last) {
                        e.preventDefault();
                        setDropdownOpen(false);
                        dropdownToggle.focus();
                    }
                }
            });
        }
    });

    // Recherche en temps réel dans la navbar
    const searchInput = document.getElementById('searchInputInline');
    const searchResults = document.getElementById('searchResults');
    const searchForm = document.querySelector('.search-form-inline');
    let searchTimeout;

    if (searchInput && searchResults) {
        // Empêcher la soumission du formulaire
        searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
        });

        // Recherche lors de la saisie
        searchInput.addEventListener('input', function() {
            const query = this.value.trim();
            
            // Vider les résultats si moins de 2 caractères
            if (query.length < 2) {
                searchResults.innerHTML = '';
                searchResults.classList.remove('show');
                return;
            }

            // Débounce pour éviter trop de requêtes
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                performSearch(query);
            }, 300);
        });

        // Masquer les résultats quand on perd le focus
        searchInput.addEventListener('blur', function() {
            // Délai pour permettre de cliquer sur un résultat
            setTimeout(() => {
                searchResults.classList.remove('show');
            }, 200);
        });

        // Réafficher les résultats quand on reprend le focus
        searchInput.addEventListener('focus', function() {
            if (searchResults.innerHTML.trim() !== '') {
                searchResults.classList.add('show');
            }
        });

        function performSearch(query) {
            // Afficher un loader avec animation
            searchResults.innerHTML = '<div class="search-loading">✨ Recherche de produits magiques...</div>';
            searchResults.classList.add('show');

            // Faire la requête AJAX
            fetch(`/product/search?q=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(products => {
                    displaySearchResults(products, query);
                })
                .catch(error => {
                    console.error('Erreur de recherche:', error);
                    searchResults.innerHTML = '<div class="search-error">😿 Oups ! Problème de connexion</div>';
                });
        }

        function displaySearchResults(products, query) {
            if (products.length === 0) {
                searchResults.innerHTML = `<div class="search-no-results">🔍 Aucun produit trouvé pour "${query}"<br><small>Essayez avec d'autres mots-clés</small></div>`;
                return;
            }

            let html = '<div class="search-results-list">';
            products.forEach((product, index) => {
                const priceDisplay = product.isPromo && product.promotionalPrice ? 
                    `<span class="search-result-old-price">${product.price}€</span><span class="search-result-promo-price">${product.promotionalPrice}€</span>` :
                    `<span class="search-result-price">${product.price}€</span>`;
                
                const categoryInfo = product.category && product.subcategory ? 
                    `<div class="search-result-category">${product.category} › ${product.subcategory}</div>` :
                    (product.category ? `<div class="search-result-category">${product.category}</div>` : '');
                
                const stockInfo = product.inStock ? 
                    '<span class="search-result-stock in-stock">✅ En stock</span>' :
                    '<span class="search-result-stock out-of-stock">❌ Rupture</span>';
                
                const promoIcon = product.isPromo ? '<span class="search-result-promo-badge">🏷️ PROMO</span>' : '';
                
                html += `
                    <a href="${product.url}" class="search-result-item" style="animation-delay: ${index * 0.05}s;">
                        <img src="${product.image}" alt="${product.name}" class="search-result-image" loading="lazy">
                        <div class="search-result-info">
                            <div class="search-result-header">
                                <div class="search-result-name">${highlightSearchTerm(product.name, query)}</div>
                                ${promoIcon}
                            </div>
                            ${categoryInfo}
                            ${product.description ? `<div class="search-result-description">${highlightSearchTerm(product.description, query)}</div>` : ''}
                            <div class="search-result-footer">
                                <div class="search-result-pricing">${priceDisplay}</div>
                                ${stockInfo}
                            </div>
                        </div>
                    </a>
                `;
            });
            html += '</div>';
            
            searchResults.innerHTML = html;
        }

        function highlightSearchTerm(text, term) {
            if (!term || term.length < 2) return text;
            const regex = new RegExp(`(${term})`, 'gi');
            return text.replace(regex, '<mark style="background: rgba(255, 140, 66, 0.3); padding: 0 2px; border-radius: 3px;">$1</mark>');
        }

        // Recherche en temps réel dans la navbar
    }

        // Fermer les résultats si on clique ailleurs
        document.addEventListener('click', function(e) {
            if (!searchInput.closest('.navbar-search').contains(e.target)) {
                searchResults.classList.remove('show');
            }
        });

});

window.updateCartCounter = function() {
    fetch('/cart/cart-count')
        .then(response => response.json())
        .then(data => {
            const counter = document.getElementById('cart-counter');
            if (counter) {
                if (data.count > 0) {
                    counter.textContent = data.count;
                    counter.style.display = 'flex';

                    counter.classList.remove('bounce');
                    counter.offsetHeight;
                    counter.classList.add('bounce');

                    setTimeout(() => {
                        counter.classList.remove('bounce');
                    }, 600);

                    // Mettre à jour l'aria-label du bouton panier pour les lecteurs d'écran
                    const cartBtn = document.querySelector('a[aria-label="Panier"]');
                    if (cartBtn) {
                        cartBtn.setAttribute('aria-label', `Panier (${data.count} article${data.count > 1 ? 's' : ''})`);
                    }
                } else {
                    counter.style.display = 'none';
                    counter.textContent = '';
                    const cartBtn = document.querySelector('a[aria-label^="Panier"]');
                    if (cartBtn) cartBtn.setAttribute('aria-label', 'Panier (vide)');
                }
            }
        })
        .catch(error => {
            // Erreur silencieuse pour le compteur
        });
};

// Différer le compteur panier après le LCP pour ne pas bloquer le chargement critique
    if ('requestIdleCallback' in window) {
        requestIdleCallback(() => window.updateCartCounter(), { timeout: 2000 });
    } else {
        setTimeout(() => window.updateCartCounter(), 0);
    }

document.addEventListener('DOMContentLoaded', function () {
    const categoryLinks = document.querySelectorAll('.dropdown-item-main, .subcategory-item');

    categoryLinks.forEach(link => {
        // Vérifier que l'événement n'est pas déjà attaché
        if (link.dataset.clickHandlerAttached) {
            return;
        }
        link.dataset.clickHandlerAttached = 'true';

        link.addEventListener('click', function (e) {
            e.preventDefault(); // Empêcher la navigation par défaut
            e.stopPropagation(); // Empêcher la propagation
            
            console.log('🖱️ CLIC SUR LE LIEN:', this.textContent.trim());
            console.log('🖱️ TIMESTAMP:', new Date().getTime());
            console.log('🔍 URL originale:', this.href);
            
            // Vérifier que le href est valide
            if (!this.href || this.href === '#') {
                console.log('⚠️ URL invalide, ignorer le clic');
                return;
            }
            
            const url = new URL(this.href);
            const params = new URLSearchParams(url.search);

            console.log('🔍 Paramètres extraits:', params.toString());

            // Vérifier si on est sur la page produit
            if (window.location.pathname === '/product') {
                console.log('🔄 Navigation depuis navbar - Rechargement de la page');
                console.log('🔄 Redirection vers:', this.href);
                
                // Recharger la page avec la nouvelle URL pour récupérer les produits du serveur
                window.location.href = this.href;
                
            } else {
                console.log('🔄 Redirection vers la page produit');
                window.location.href = this.href;
            }
        });
    });

    // Fonction pour synchroniser les filtres avec l'URL
    function syncFiltersWithURL(params) {
        const categoryFilter = document.querySelector('#categoryFilter');
        const subcategoryFilter = document.querySelector('#subcategoryFilter');

        if (categoryFilter && params.has('category')) {
            categoryFilter.value = params.get('category');
        }

        if (subcategoryFilter && params.has('subcategory')) {
            subcategoryFilter.value = params.get('subcategory');
        }
    }

    // Fonction pour mettre à jour la liste des produits
    function updateProductList(params) {
        fetch(`/product?${params.toString()}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Erreur lors de la récupération des produits');
                }
                return response.text();
            })
            .then(html => {
                const productContainer = document.querySelector('#productContainer');
                if (productContainer) {
                    productContainer.innerHTML = html;
                }
            })
            .catch(error => {
                console.error('Erreur lors de la mise à jour des produits :', error);
            });
    }
});
</script>
