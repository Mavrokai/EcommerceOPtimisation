{# 
  Component: Promo Card
  Props: promotion (Entity Promotion), size ('large'|'medium'|'small')
#}
{% set cardSize = size|default('medium') %}
{% set cardClass = 'promo-card promo-card--' ~ cardSize %}

<div class="{{ cardClass }}">
    <a href="{{ promotion.buttonUrl|default('#') }}" class="promo-link">
        <div class="promo-image-container">
            {% if promotion.imageUrl starts with 'http' %}
                <picture>
                    <img
                        src="{{ promotion.imageUrl }}"
                        alt="{{ promotion.title }}"
                        class="promo-image"
                        loading="lazy"
                        onerror="this.src='{{ asset('assets/images/promo-image.png') }}'">
                </picture>
            {% else %}
                {% set baseWidth = cardSize == 'large' ? 160 : (cardSize == 'small' ? 100 : 150) %}
                {% set thumb1x = thumb_url(promotion.imageUrl, baseWidth) %}
                {% set thumb2x = thumb_url(promotion.imageUrl, baseWidth * 2) %}
                <picture>
                    <img
                        src="{{ thumb1x }}"
                        srcset="{{ thumb1x }} 1x, {{ thumb2x }} 2x"
                        alt="{{ promotion.title }}"
                        class="promo-image"
                        width="{{ baseWidth }}"
                        height="{{ baseWidth }}"
                        loading="lazy"
                        onerror="this.src='{{ asset('assets/images/promo-image.png') }}'; this.srcset='';">
                </picture>
            {% endif %}
            {% if promotion.discountPercent %}
                <div class="discount-badge">
                    -{{ promotion.discountPercent|number_format(0) }}%
                </div>
            {% endif %}
            {% if promotion.badge %}
                <div class="promo-badge">
                    {{ promotion.badge }}
                </div>
            {% endif %}
        </div>
        
        <div class="promo-content">
            <h3 class="promo-title">{{ promotion.title }}</h3>
            {% if promotion.description %}
                <p class="promo-description">{{ promotion.description }}</p>
            {% endif %}
            {% if promotion.productName is defined %}
                <p class="promo-product-name">{{ promotion.productName }}</p>
            {% endif %}
            {% if promotion.productPrice is defined %}
                <div class="promo-price">
                    {% if promotion.discountPercent %}
                        <span class="original-price">{{ (promotion.productPrice * (1 + promotion.discountPercent / 100))|number_format(2) }}€</span>
                    {% endif %}
                    <span class="current-price">{{ promotion.productPrice|number_format(2) }}€</span>
                </div>
            {% endif %}
            <span class="promo-button">
                {{ promotion.buttonText|default('Découvrir') }}
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
            </span>
        </div>
    </a>
</div>

<style>
.promo-card {
    border-radius: 16px;
    overflow: visible;
    background: transparent;
    box-shadow: none;
    transition: all 0.3s ease;
    position: relative;
}

.promo-card:hover {
    transform: translateY(-5px);
    box-shadow: none;
}

.promo-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
}

.promo-image-container {
    position: relative;
    overflow: visible;
}

.promo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.3s ease;
}

.promo-card:hover .promo-image {
    transform: scale(1.05);
}

.discount-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--primary-orange);
    color: white;
    padding: 0.5rem 0.75rem;
    border-radius: 20px;
    font-weight: bold;
    font-size: 0.875rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 2;
}

.promo-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.4rem 0.7rem;
    border-radius: 15px;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
    z-index: 2;
}
    box-shadow: 0 2px 8px rgba(251, 150, 41, 0.3);
}

.promo-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 12px;
    margin-top: -20px;
    position: relative;
    z-index: 2;
    backdrop-filter: blur(10px);
}

.promo-title {
    font-family: var(--font-heading);
    margin: 0 0 0.5rem 0;
    color: #1a202c;
    line-height: 1.3;
    font-weight: 700;
}

.promo-description {
    color: #2d3748;
    margin: 0 0 1rem 0;
    line-height: 1.5;
    flex-grow: 1;
    font-weight: 500;
}

.promo-button {
    color: #2b6cb0;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    transition: color 0.3s ease;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.promo-card:hover .promo-button {
    color: #1a365d;
    text-decoration: underline;
}

.promo-button svg {
    transition: transform 0.3s ease;
}

.promo-card:hover .promo-button svg {
    transform: translateX(4px);
}

.promo-product-name {
    font-size: 0.9rem;
    color: #4a5568;
    margin: 0.5rem 0;
    font-weight: 600;
}

.promo-price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0;
}

.original-price {
    text-decoration: line-through;
    color: #718096;
    font-size: 0.9rem;
    font-weight: 500;
}

.current-price {
    font-size: 1.2rem;
    font-weight: 800;
    color: #c53030;
}

.promo-card--large .promo-image-container {
    height: 160px;
}

.promo-card--large .promo-title {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
}

.promo-card--large .promo-description {
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.promo-card--medium .promo-image-container {
    height: 150px;
}

.promo-card--medium .promo-title {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
}

.promo-card--medium .promo-description {
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
}

.promo-card {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.promo-link {
    height: 100%;
    display: flex;
    flex-direction: column;
}

.promo-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1rem;
}

.promo-content > *:last-child {
    margin-top: auto;
}

.promo-card--small .promo-image-container {
    height: 100px;
}

.promo-card--small .promo-title {
    font-size: 1.1rem;
}

.promo-card--small .promo-description {
    font-size: 0.875rem;
}

.promo-card--small .promo-content {
    padding: 1rem;
}

/* Responsive */
@media (max-width: 768px) {
    .promo-card--large,
    .promo-card--medium,
    .promo-card--small {
        grid-column: span 1;
        grid-row: span 1;
        margin-bottom: 1rem;
    }
    
    .promo-card--large .promo-image-container,
    .promo-card--medium .promo-image-container,
    .promo-card--small .promo-image-container {
        height: 120px;
    }
    
    .promo-title {
        font-size: 1rem !important;
        margin: 0 0 0.25rem 0;
    }
    
    .promo-description {
        font-size: 0.8rem !important;
        margin: 0 0 0.75rem 0;
        line-height: 1.4;
    }
    
    .promo-content {
        padding: 0.75rem;
    }
    
    .promo-button {
        font-size: 0.875rem;
    }
}
</style>
