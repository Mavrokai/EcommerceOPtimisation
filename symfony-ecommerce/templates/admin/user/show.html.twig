{% extends 'admin/base.html.twig' %}

{% block page_title %}Détails de l'Utilisateur{% endblock %}

{% block breadcrumbs %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a href="{{ path('admin_user_index') }}">Utilisateurs</a>
    </li>
    <li class="breadcrumb-item active">{{ user.email }}</li>
{% endblock %}

{% block header_actions %}
    <div class="btn-group">
        <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-warning">
            <i class="fas fa-edit me-2"></i>
            Modifier
        </a>
        {% if user != app.user %}
            <form method="post" 
                  action="{{ path('admin_user_delete', {'id': user.id}) }}" 
                  class="d-inline"
                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>
                    Supprimer
                </button>
            </form>
        {% endif %}
    </div>
{% endblock %}

{% block content %}
<div class="row">
    <!-- Informations principales -->
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-user me-2"></i>
                    Informations Personnelles
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label text-muted">ID Utilisateur</label>
                            <div class="fw-bold">#{{ user.id }}</div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Adresse Email</label>
                            <div class="fw-bold">
                                {{ user.email }}
                                {% if not user.isVerified %}
                                    <span class="badge bg-warning ms-2">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        Non vérifié
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Prénom</label>
                            <div class="fw-bold">
                                {% if user.firstName %}
                                    {{ user.firstName }}
                                {% else %}
                                    <span class="text-muted fst-italic">Non renseigné</span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Nom de famille</label>
                            <div class="fw-bold">
                                {% if user.lastName %}
                                    {{ user.lastName }}
                                {% else %}
                                    <span class="text-muted fst-italic">Non renseigné</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label text-muted">Type de compte</label>
                            <div>
                                {% if user.isAdmin %}
                                    <span class="badge bg-danger fs-6">
                                        <i class="fas fa-user-shield me-1"></i>
                                        Administrateur
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary fs-6">
                                        <i class="fas fa-user me-1"></i>
                                        Utilisateur standard
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Statut du compte</label>
                            <div>
                                {% if user.isVerified %}
                                    <span class="badge bg-success fs-6">
                                        <i class="fas fa-check-circle me-1"></i>
                                        Compte vérifié
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning fs-6">
                                        <i class="fas fa-clock me-1"></i>
                                        En attente de vérification
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Date d'inscription</label>
                            <div class="fw-bold">{{ user.createdAt|date('d/m/Y à H:i') }}</div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Dernière modification</label>
                            <div class="fw-bold">
                                {% if user.updatedAt %}
                                    {{ user.updatedAt|date('d/m/Y à H:i') }}
                                {% else %}
                                    <span class="text-muted fst-italic">Jamais modifié</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Adresses -->
        {% if user.addresses|length > 0 %}
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-map-marker-alt me-2"></i>
                    Adresses
                    <span class="badge bg-primary ms-2">{{ user.addresses|length }}</span>
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    {% for address in user.addresses %}
                    <div class="col-md-6 mb-3">
                        <div class="border rounded p-3 {% if address.isDefault %}border-primary bg-light{% endif %}">
                            {% if address.isDefault %}
                                <div class="badge bg-primary mb-2">
                                    <i class="fas fa-star me-1"></i>
                                    Adresse par défaut
                                </div>
                            {% endif %}
                            <div class="fw-bold">{{ address.firstName }} {{ address.lastName }}</div>
                            <div>{{ address.street }}</div>
                            {% if address.complement %}
                                <div>{{ address.complement }}</div>
                            {% endif %}
                            <div>{{ address.postalCode }} {{ address.city }}</div>
                            {% if address.phone %}
                                <div class="text-muted">
                                    <i class="fas fa-phone me-1"></i>
                                    {{ address.phone }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Commandes récentes -->
        {% if user.orders|length > 0 %}
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-shopping-cart me-2"></i>
                    Commandes Récentes
                    <span class="badge bg-primary ms-2">{{ user.orders|length }}</span>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>N° Commande</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th>Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in user.orders|slice(0, 5) %}
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark">#{{ order.id }}</span>
                                </td>
                                <td>{{ order.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <span class="badge bg-{% if order.status == 'livree' %}success{% elseif order.status == 'en_cours' %}warning{% else %}secondary{% endif %}">
                                        {{ order.status|trans }}
                                    </span>
                                </td>
                                <td class="fw-bold">{{ order.total|number_format(2, ',', ' ') }} €</td>
                                <td>
                                    <a href="{{ path('admin_orders_show', {'id': order.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if user.orders|length > 5 %}
                <div class="card-footer text-center">
                    <a href="{{ path('admin_orders_index') }}?user={{ user.id }}" class="btn btn-outline-primary btn-sm">
                        Voir toutes les commandes de cet utilisateur
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>

    <!-- Actions rapides -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-tools me-2"></i>
                    Actions Rapides
                </h5>
            </div>
            <div class="card-body">
                {% if user != app.user %}
                    <div class="d-grid gap-2">
                        <form method="post" action="{{ path('admin_user_toggle_admin', {'id': user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-admin' ~ user.id) }}">
                            <button type="submit" class="btn {% if user.isAdmin %}btn-outline-warning{% else %}btn-outline-success{% endif %} w-100">
                                {% if user.isAdmin %}
                                    <i class="fas fa-user-minus me-2"></i>
                                    Retirer droits admin
                                {% else %}
                                    <i class="fas fa-user-plus me-2"></i>
                                    Donner droits admin
                                {% endif %}
                            </button>
                        </form>

                        <form method="post" action="{{ path('admin_user_toggle_verified', {'id': user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-verified' ~ user.id) }}">
                            <button type="submit" class="btn {% if user.isVerified %}btn-outline-warning{% else %}btn-outline-success{% endif %} w-100">
                                {% if user.isVerified %}
                                    <i class="fas fa-times-circle me-2"></i>
                                    Marquer non vérifié
                                {% else %}
                                    <i class="fas fa-check-circle me-2"></i>
                                    Marquer vérifié
                                {% endif %}
                            </button>
                        </form>
                    </div>
                {% else %}
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Ceci est votre propre compte. Vous ne pouvez pas modifier vos propres droits depuis cette interface.
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Statistiques de l'utilisateur -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-chart-bar me-2"></i>
                    Statistiques
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <div class="fs-4 fw-bold text-primary">{{ user.orders|length }}</div>
                            <div class="text-muted small">Commandes</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="fs-4 fw-bold text-success">{{ user.addresses|length }}</div>
                        <div class="text-muted small">Adresses</div>
                    </div>
                </div>
                <hr>
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <div class="fs-4 fw-bold text-warning">{{ user.reviews|length }}</div>
                            <div class="text-muted small">Avis</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="fs-4 fw-bold text-info">
                            {% set totalSpent = 0 %}
                            {% for order in user.orders %}
                                {% if order.status == 'livree' %}
                                    {% set totalSpent = totalSpent + order.total %}
                                {% endif %}
                            {% endfor %}
                            {{ totalSpent|number_format(0, ',', ' ') }}€
                        </div>
                        <div class="text-muted small">Dépensé</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
