{% extends 'admin/base.html.twig' %}

{% block page_title %}Nouveau Utilisateur{% endblock %}

{% block breadcrumbs %}
    {{ parent() }}
    <li class="breadcrumb-item">
        <a href="{{ path('admin_user_index') }}">Utilisateurs</a>
    </li>
    <li class="breadcrumb-item active">Nouveau</li>
{% endblock %}

{% block header_actions %}
    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>
        Retour à la liste
    </a>
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-user-plus me-2"></i>
                    Créer un Nouvel Utilisateur
                </h5>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                
                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            {{ form_label(form.email, null, {'label_attr': {'class': 'form-label required'}}) }}
                            {{ form_widget(form.email) }}
                            {{ form_errors(form.email) }}
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                L'adresse email servira d'identifiant de connexion
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.firstName) }}
                            {{ form_widget(form.firstName) }}
                            {{ form_errors(form.firstName) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.lastName) }}
                            {{ form_widget(form.lastName) }}
                            {{ form_errors(form.lastName) }}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'form-label required'}}) }}
                            {{ form_widget(form.plainPassword.first) }}
                            {{ form_errors(form.plainPassword.first) }}
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Minimum 6 caractères
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'form-label required'}}) }}
                            {{ form_widget(form.plainPassword.second) }}
                            {{ form_errors(form.plainPassword.second) }}
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.isAdmin) }}
                                {{ form_label(form.isAdmin) }}
                            </div>
                            <div class="form-text">
                                {{ form_help(form.isAdmin) }}
                            </div>
                            {{ form_errors(form.isAdmin) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                {{ form_widget(form.isVerified) }}
                                {{ form_label(form.isVerified) }}
                            </div>
                            <div class="form-text">
                                {{ form_help(form.isVerified) }}
                            </div>
                            {{ form_errors(form.isVerified) }}
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>
                        Annuler
                    </a>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>
                        Créer l'Utilisateur
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-lightbulb me-2"></i>
                    Conseils pour la création d'utilisateurs
                </h6>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li><strong>Email :</strong> Doit être unique et valide. Servira d'identifiant de connexion.</li>
                    <li><strong>Mot de passe :</strong> Choisissez un mot de passe sécurisé d'au moins 6 caractères.</li>
                    <li><strong>Administrateur :</strong> Les administrateurs ont accès à cette interface d'administration.</li>
                    <li><strong>Compte vérifié :</strong> Les comptes créés par l'admin sont automatiquement vérifiés par défaut.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
.form-label.required::after {
    content: " *";
    color: #dc3545;
}
</style>
{% endblock %}
