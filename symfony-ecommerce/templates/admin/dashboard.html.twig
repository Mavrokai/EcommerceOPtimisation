{% extends 'admin/base.html.twig' %}

{% block page_title %}Tableau de Bord{% endblock %}

{% block breadcrumbs %}
    {{ parent() }}
    <li class="breadcrumb-item active">Tableau de bord</li>
{% endblock %}

{% block content %}
<div class="row mb-4">
    {% set statsData = [
        {name: 'Catégories', value: stats.categories, icon: 'fas fa-tags', color: 'primary', route: 'admin_category_index', extra: null},
        {name: 'Produits', value: stats.products, icon: 'fas fa-box', color: 'success', route: 'admin_product_index', extra: null},
        {name: 'Commandes', value: stats.orders, icon: 'fas fa-shopping-cart', color: 'danger', route: 'admin_orders_index', extra: stats.orders_pending > 0 ? stats.orders_pending ~ ' en attente' : null},
        {name: 'Utilisateurs', value: stats.users, icon: 'fas fa-users', color: 'info', route: 'admin_user_index', extra: null}
    ] %}
    
    {% for stat in statsData %}
    <div class="col-md-3">
        <div class="card stats-card">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6 class="card-title text-muted mb-1">
                            <i class="{{ stat.icon }} text-{{ stat.color }} me-2"></i>
                            {{ stat.name }}
                        </h6>
                        <div class="stats-number">{{ stat.value }}</div>
                        {% if stat.extra %}
                        <small class="text-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            {{ stat.extra }}
                        </small>
                        {% endif %}
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="{{ path(stat.route) }}" class="btn btn-outline-{{ stat.color }} btn-sm">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-bolt me-2"></i>
                    Actions Rapides
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    {% set quickActions = [
                        {title: 'Nouvelle Catégorie', route: 'admin_category_new', icon: 'fas fa-plus', color: 'primary', badge: null},
                        {title: 'Nouveau Produit', route: 'admin_product_new', icon: 'fas fa-plus', color: 'success', badge: null},
                        {title: 'Nouvel Utilisateur', route: 'admin_user_new', icon: 'fas fa-user-plus', color: 'info', badge: null},
                        {title: 'Voir Commandes', route: 'admin_orders_index', icon: 'fas fa-shopping-cart', color: 'danger', badge: stats.orders_pending > 0 ? stats.orders_pending : null}
                    ] %}
                    
                    {% for action in quickActions %}
                    <div class="col-md-3">
                        <div class="d-grid">
                            <a href="{{ path(action.route) }}" class="btn btn-{{ action.color }}">
                                <i class="{{ action.icon }} me-2"></i>
                                {{ action.title }}
                                {% if action.badge %}
                                <span class="badge bg-warning text-dark ms-1">{{ action.badge }}</span>
                                {% endif %}
                            </a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

{% if recentCategories or recentOrders %}
<div class="row">
    {% if recentCategories %}
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-tags me-2"></i>
                    Catégories Récentes
                </h6>
            </div>
            <div class="card-body">
                {% for category in recentCategories|slice(0, 3) %}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <strong>{{ category.name }}</strong>
                        <br>
                        <small class="text-muted">{{ category.createdAt|date('d/m/Y') }}</small>
                    </div>
                    <a href="{{ path('admin_category_show', {'id': category.id}) }}" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-eye"></i>
                    </a>
                </div>
                {% endfor %}
                <div class="text-center">
                    <a href="{{ path('admin_category_index') }}" class="btn btn-sm btn-outline-primary">
                        Voir toutes
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    
    {% if recentOrders %}
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-shopping-cart me-2"></i>
                    Commandes Récentes
                </h6>
            </div>
            <div class="card-body">
                {% for order in recentOrders|slice(0, 3) %}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <strong>#{{ order.id }}</strong> - {{ order.total }}€
                        <br>
                        <span class="badge bg-{{ order.status == 'en_attente' ? 'warning' : 'success' }}">
                            {{ order.statusLabel }}
                        </span>
                        <small class="text-muted ms-2">{{ order.createdAt|date('d/m/Y') }}</small>
                    </div>
                    <a href="{{ path('admin_orders_show', {'id': order.id}) }}" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-eye"></i>
                    </a>
                </div>
                {% endfor %}
                <div class="text-center">
                    <a href="{{ path('admin_orders_index') }}" class="btn btn-sm btn-outline-danger">
                        Voir toutes
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endif %}

{% endblock %}
