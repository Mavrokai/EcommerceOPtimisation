{% extends 'admin/base.html.twig' %}

{% block title %}Administration - Modifier {{ product.name }}{% endblock %}

{% block page_title %}Modifier "{{ product.name }}"{% endblock %}

{% block breadcrumbs %}
    {{ parent() }}
    <li class="breadcrumb-item"><a href="{{ path('admin_product_index') }}">Produits</a></li>
    <li class="breadcrumb-item active">Modifier</li>
{% endblock %}

{% block header_actions %}
    <div class="header-actions">
        <a href="{{ path('admin_product_show', {'id': product.id}) }}" class="btn btn-outline-info btn-sm">
            <i class="fas fa-eye"></i>
            Voir
        </a>
        <a href="{{ path('admin_product_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i>
            Retour à la liste
        </a>
    </div>
{% endblock %}

{% block content %}
<div class="dashboard-container">
    <div class="dashboard-content">
        <!-- Formulaire principal -->
        <div class="dashboard-card">
            <div class="card-header">
                <i class="fas fa-edit"></i>
                Modification du produit
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data', 'class': 'product-form'}}) }}
                
                <div class="form-grid">
                    <!-- Nom du produit -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-tag"></i>
                            Nom du produit
                        </label>
                        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Nom du produit'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <!-- Description -->
                    <div class="form-group full-width">
                        <label class="form-label">
                            <i class="fas fa-align-left"></i>
                            Description
                        </label>
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '3', 'placeholder': 'Description du produit...'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <!-- Prix -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-euro-sign"></i>
                            Prix
                        </label>
                        <div class="input-group">
                            {{ form_widget(form.price, {'attr': {'class': 'form-control', 'step': '0.01', 'placeholder': '0.00'}}) }}
                            <span class="input-group-text">€</span>
                        </div>
                        {{ form_errors(form.price) }}
                    </div>

                    <!-- Stock -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-boxes"></i>
                            Stock
                        </label>
                        {{ form_widget(form.stock, {'attr': {'class': 'form-control', 'placeholder': '0'}}) }}
                        {{ form_errors(form.stock) }}
                    </div>

                    <!-- Poids -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-weight"></i>
                            Poids
                        </label>
                        <div class="input-group">
                            {{ form_widget(form.weight, {'attr': {'class': 'form-control', 'step': '0.01', 'placeholder': '0.00'}}) }}
                            <span class="input-group-text">kg</span>
                        </div>
                        {{ form_errors(form.weight) }}
                    </div>

                    <!-- Catégorie -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-tags"></i>
                            Catégorie
                        </label>
                        {{ form_widget(form.subCategory, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.subCategory) }}
                    </div>

                    <!-- Image -->
                    <div class="form-group full-width">
                        <label class="form-label">
                            <i class="fas fa-image"></i>
                            Image
                        </label>
                        {{ form_widget(form.imageUrl, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
                        {{ form_errors(form.imageUrl) }}
                        {% if product.imageUrl %}
                            <div class="current-image-preview">
                                <img src="{{ asset('assets/images/' ~ product.imageUrl) }}" 
                                     alt="{{ product.name }}"
                                     onerror="this.style.display='none'">
                                <span class="image-label">Image actuelle</span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Options -->
                    <div class="form-group full-width">
                        <label class="form-label">
                            <i class="fas fa-cogs"></i>
                            Options du produit
                        </label>
                        <div class="options-grid">
                            <div class="option-item">
                                {{ form_widget(form.isPromo, {'attr': {'class': 'form-check-input', 'id': 'promo-switch'}}) }}
                                <label for="promo-switch" class="option-label">
                                    En promotion
                                </label>
                            </div>
                            
                            <div class="option-item" id="promo-percentage" style="display: none;">
                                <div class="input-group">
                                    {{ form_widget(form.promoPercentage, {'attr': {'class': 'form-control', 'placeholder': '0'}}) }}
                                    <span class="input-group-text">%</span>
                                </div>
                                {{ form_errors(form.promoPercentage) }}
                            </div>
                            
                            <div class="option-item">
                                {{ form_widget(form.isNew, {'attr': {'class': 'form-check-input'}}) }}
                                <label class="option-label">
                                    Nouveau produit
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="form-actions">
                    <div class="actions-left">
                        <button type="button" class="btn btn-danger btn-delete" onclick="confirmDelete()" title="Supprimer définitivement ce produit">
                            <i class="fas fa-trash-alt"></i>
                            Supprimer définitivement
                        </button>
                    </div>
                    <div class="actions-right">
                        <a href="{{ path('admin_product_index') }}" class="btn btn-secondary">
                            <i class="fas fa-times"></i>
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            Sauvegarder
                        </button>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <!-- Informations du produit -->
        <div class="dashboard-card">
            <div class="card-header">
                <i class="fas fa-info-circle"></i>
                Informations
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">ID</div>
                        <div class="info-value">{{ product.id }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Stock</div>
                        <div class="info-value {% if product.stock < 5 %}text-danger{% elseif product.stock < 10 %}text-warning{% else %}text-success{% endif %}">
                            {{ product.stock }}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Prix actuel</div>
                        <div class="info-value" id="current-price">
                            {% if product.isPromo and product.promoPercentage %}
                                <span class="original-price">{{ product.price|number_format(2, ',', ' ') }} €</span>
                                <span class="promo-price">{{ product.promotionalPrice|number_format(2, ',', ' ') }} €</span>
                            {% else %}
                                {{ product.price|number_format(2, ',', ' ') }} €
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Statut</div>
                        <div class="info-value">
                            {% if product.isPromo %}
                                <span class="status-badge promo">PROMO</span>
                            {% endif %}
                            {% if product.isNew %}
                                <span class="status-badge new">NOUVEAU</span>
                            {% endif %}
                            {% if not product.isPromo and not product.isNew %}
                                <span class="status-badge normal">NORMAL</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Créé le</div>
                        <div class="info-value">{{ product.createdAt|date('d/m/Y H:i') }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Modifié le</div>
                        <div class="info-value">{{ product.updatedAt|date('d/m/Y H:i') }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" action="{{ path('admin_product_delete', {'id': product.id}) }}" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
</form>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
<style>
/* Dashboard Container */
.dashboard-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    background: var(--cream);
    min-height: 100vh;
}

/* Dashboard Content */
.dashboard-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

/* Dashboard Card */
.dashboard-card {
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

.card-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 1.5rem;
    border-bottom: 1px solid #eee;
    font-weight: 600;
    color: var(--primary-orange);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.card-body {
    padding: 2rem;
}

/* Form Grid */
.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group.full-width {
    grid-column: 1 / -1;
}

.form-label {
    font-weight: 600;
    color: #666;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.form-control {
    padding: 0.75rem 1rem;
    border: 2px solid #e9ecef;
    border-radius: 10px;
    font-family: var(--font-body, 'Inter', sans-serif);
    transition: all 0.3s ease;
}

.form-control:focus {
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 3px rgba(251, 150, 41, 0.1);
    outline: none;
}

.input-group {
    display: flex;
}

.input-group .form-control {
    border-right: none;
    border-radius: 10px 0 0 10px;
}

.input-group-text {
    background: #f8f9fa;
    border: 2px solid #e9ecef;
    border-left: none;
    border-radius: 0 10px 10px 0;
    padding: 0.75rem 1rem;
    color: #666;
}

/* Current Image Preview */
.current-image-preview {
    margin-top: 1rem;
    text-align: center;
}

.current-image-preview img {
    max-width: 200px;
    max-height: 150px;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.image-label {
    display: block;
    margin-top: 0.5rem;
    color: #666;
    font-size: 0.9rem;
}

/* Options Grid */
.options-grid {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 1rem;
    align-items: center;
}

.option-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* Animation pour le champ pourcentage promo */
#promo-percentage {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
}

#promo-percentage.show {
    animation: slideIn 0.3s ease-out;
}

#promo-percentage.hide {
    animation: slideOut 0.3s ease-in;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-10px);
        max-height: 0;
    }
    to {
        opacity: 1;
        transform: translateY(0);
        max-height: 100px;
    }
}

@keyframes slideOut {
    from {
        opacity: 1;
        transform: translateY(0);
        max-height: 100px;
    }
    to {
        opacity: 0;
        transform: translateY(-10px);
        max-height: 0;
    }
}

.option-label {
    font-weight: 500;
    color: #666;
    margin: 0;
}

.form-check-input {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    cursor: pointer;
}

/* Form Actions */
.form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 2px solid #f8f9fa;
}

.actions-left,
.actions-right {
    display: flex;
    gap: 1rem;
}

/* Buttons - Utilise le style de base de l'admin */
.btn {
    border-radius: 25px;
    font-weight: 600;
    font-family: var(--font-body);
    transition: all 0.3s ease;
    border: none;
    position: relative;
    overflow: hidden;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
}

.btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: all 0.3s ease;
    z-index: 0;
}

.btn:hover::before {
    width: 300px;
    height: 300px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: white;
    padding: 12px 24px;
}

.btn-primary:hover {
    background: linear-gradient(135deg, var(--secondary-orange) 0%, var(--dark-orange) 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(251, 150, 41, 0.4);
}

.btn-secondary {
    background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
    color: white;
}

.btn-secondary:hover {
    background: linear-gradient(135deg, #5a6268 0%, #495057 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(108, 117, 125, 0.4);
}

.btn-danger {
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    color: white;
}

.btn-danger:hover {
    background: linear-gradient(135deg, #c82333 0%, #a71e2a 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(220, 53, 69, 0.4);
}

/* Style spécial pour le bouton de suppression */
.btn-delete {
    position: relative;
    overflow: hidden;
    border: 2px solid #dc3545;
    background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
    color: white;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
}

.btn-delete::before {
    content: '⚠️';
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    font-size: 1.2em;
    transition: all 0.3s ease;
}

.btn-delete:hover::before {
    top: 2px;
}

.btn-delete:hover {
    background: linear-gradient(135deg, #a71e2a 0%, #8b1a1a 100%);
    border-color: #a71e2a;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 10px 25px rgba(220, 53, 69, 0.6);
    animation: pulse-danger 0.8s infinite;
}

@keyframes pulse-danger {
    0% { box-shadow: 0 10px 25px rgba(220, 53, 69, 0.6); }
    50% { box-shadow: 0 15px 35px rgba(220, 53, 69, 0.8); }
    100% { box-shadow: 0 10px 25px rgba(220, 53, 69, 0.6); }
}

.btn-delete:active {
    transform: translateY(-1px) scale(0.98);
    box-shadow: 0 5px 15px rgba(220, 53, 69, 0.5);
}

/* Boutons outline pour le header */
.btn-outline-info {
    border: 2px solid #17a2b8;
    background: rgba(23, 162, 184, 0.1);
    color: #17a2b8;
}

.btn-outline-info:hover {
    background: #17a2b8;
    color: white;
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(23, 162, 184, 0.3);
}

.btn-outline-secondary {
    border: 2px solid #6c757d;
    background: rgba(108, 117, 125, 0.1);
    color: #6c757d;
}

.btn-outline-secondary:hover {
    background: #6c757d;
    color: white;
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(108, 117, 125, 0.3);
}

.btn-sm {
    padding: 8px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    min-width: 42px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* Header Actions */
.header-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
}

/* Info Grid */
.info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}

.info-item {
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 10px;
    text-align: center;
}

.info-label {
    font-size: 0.8rem;
    color: #666;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.info-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
}

/* Status Badges */
.status-badge {
    padding: 0.25rem 0.5rem;
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 600;
    color: white;
    text-align: center;
    display: inline-block;
    margin: 0.1rem;
}

.status-badge.promo {
    background: #f39c12;
}

.status-badge.new {
    background: #27ae60;
}

.status-badge.normal {
    background: #6c757d;
}

/* Price Display */
.original-price {
    text-decoration: line-through;
    color: #999;
    font-size: 0.9rem;
}

.promo-price {
    color: var(--primary-orange);
    font-weight: 700;
    font-size: 1.2rem;
}

/* Responsive */
@media (max-width: 768px) {
    .dashboard-container {
        padding: 1rem;
    }
    
    .form-grid {
        grid-template-columns: 1fr;
    }
    
    .info-grid {
        grid-template-columns: 1fr;
    }
    
    .options-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    
    .form-actions {
        flex-direction: column;
        gap: 1rem;
    }
    
    .actions-left,
    .actions-right {
        justify-content: center;
    }
}
</style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Attendre un peu pour s'assurer que tous les éléments sont chargés
    setTimeout(function() {
        // Gestion du champ pourcentage de promotion - essayer plusieurs sélecteurs
        let promoSwitch = document.getElementById('promo-switch');
        
        // Si pas trouvé avec l'ID, essayer avec un sélecteur de champ form
        if (!promoSwitch) {
            promoSwitch = document.querySelector('input[name*="isPromo"]');
            console.log('Checkbox trouvée avec sélecteur name:', promoSwitch);
        }
        
        const promoPercentage = document.getElementById('promo-percentage');
        const currentPrice = document.getElementById('current-price');
        
        console.log('Elements trouvés:', {
            promoSwitch: promoSwitch,
            promoPercentage: promoPercentage,
            currentPrice: currentPrice
        });
        
        // Fonction pour afficher/masquer le champ pourcentage
        function togglePromoPercentage() {
            console.log('togglePromoPercentage appelée, checkbox checked:', promoSwitch?.checked);
            
            if (promoSwitch && promoPercentage) {
                if (promoSwitch.checked) {
                    console.log('Affichage du champ pourcentage');
                    // Afficher le champ immédiatement
                    promoPercentage.style.display = 'flex';
                    promoPercentage.style.opacity = '1';
                    promoPercentage.style.transform = 'translateY(0)';
                } else {
                    console.log('Masquage du champ pourcentage');
                    // Masquer le champ
                    promoPercentage.style.display = 'none';
                    promoPercentage.style.opacity = '0';
                    promoPercentage.style.transform = 'translateY(-10px)';
                    updatePriceDisplay();
                }
            } else {
                console.error('Éléments manquants:', {promoSwitch, promoPercentage});
            }
        }
        
        // Écouter les changements de la checkbox promo
        if (promoSwitch) {
            // Ajouter l'ID si elle ne l'a pas
            if (!promoSwitch.id) {
                promoSwitch.id = 'promo-switch';
            }
            
            promoSwitch.addEventListener('change', function() {
                console.log('Checkbox changée, nouvelle valeur:', this.checked);
                togglePromoPercentage();
            });
            
            // Initialiser l'affichage au chargement de la page
            console.log('Initialisation, checkbox checked:', promoSwitch.checked);
            togglePromoPercentage();
        } else {
            console.error('Checkbox promo-switch non trouvée du tout');
        }
    }, 100); // Attendre 100ms
    
    // Calcul en temps réel du prix promotionnel
    const priceInput = document.querySelector('input[name*="price"]');
    const promoPercentageInput = document.querySelector('input[name*="promoPercentage"]');
    
    function updatePriceDisplay() {
        if (!priceInput || !currentPrice) return;
        
        const price = parseFloat(priceInput.value) || 0;
        const percentage = parseFloat(promoPercentageInput?.value) || 0;
        const isPromo = promoSwitch?.checked;
        
        if (isPromo && percentage > 0 && percentage <= 100) {
            const promoPrice = price * (1 - (percentage / 100));
            currentPrice.innerHTML = `
                <span class="original-price">${price.toFixed(2).replace('.', ',')} €</span>
                <span class="promo-price">${promoPrice.toFixed(2).replace('.', ',')} €</span>
            `;
        } else {
            currentPrice.innerHTML = `${price.toFixed(2).replace('.', ',')} €`;
        }
    }
    
    // Écouter les changements
    if (priceInput) {
        priceInput.addEventListener('input', updatePriceDisplay);
    }
    
    if (promoPercentageInput) {
        promoPercentageInput.addEventListener('input', function() {
            const value = parseFloat(this.value) || 0;
            if (this.value && (value <= 0 || value > 100)) {
                this.style.borderColor = '#e74c3c';
            } else {
                this.style.borderColor = '';
            }
            updatePriceDisplay();
        });
    }
    
    // Preview de la nouvelle image
    const imageInput = document.querySelector('input[type="file"]');
    if (imageInput) {
        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    let preview = document.getElementById('new-image-preview');
                    if (!preview) {
                        preview = document.createElement('div');
                        preview.id = 'new-image-preview';
                        preview.className = 'current-image-preview';
                        preview.innerHTML = `
                            <img>
                            <span class="image-label">Aperçu de la nouvelle image</span>
                        `;
                        imageInput.parentNode.appendChild(preview);
                    }
                    preview.querySelector('img').src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                const preview = document.getElementById('new-image-preview');
                if (preview) {
                    preview.remove();
                }
            }
        });
    }
});

function confirmDelete() {
    const productName = '{{ product.name|escape('js') }}';
    const message = `⚠️ CONFIRMATION DE SUPPRESSION ⚠️\n\n` +
                   `Vous êtes sur le point de supprimer définitivement le produit :\n` +
                   `"${productName}"\n\n` +
                   `Cette action est IRRÉVERSIBLE !\n\n` +
                   `Toutes les données associées seront perdues :\n` +
                   `• Informations du produit\n` +
                   `• Historique des commandes\n` +
                   `• Images associées\n\n` +
                   `Êtes-vous absolument certain de vouloir continuer ?`;
    
    if (confirm(message)) {
        // Double confirmation pour les actions critiques
        const finalConfirm = confirm(`🔴 DERNIÈRE CONFIRMATION 🔴\n\nVous confirmez la suppression définitive de "${productName}" ?\n\nCliquez sur OK pour supprimer définitivement ou Annuler pour arrêter.`);
        
        if (finalConfirm) {
            document.getElementById('deleteForm').submit();
        }
    }
}
</script>
{% endblock %}
