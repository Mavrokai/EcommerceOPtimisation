{% extends 'admin/base.html.twig' %}

{% block title %}Administration - Produits{% endblock %}

{% block content %}
<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="dashboard-title">
                    <i class="fas fa-box"></i>
                    Gestion des Produits
                </h1>
                <p class="dashboard-subtitle">{{ totalProducts }} produits au total</p>
            </div>
            <div class="dashboard-actions">
                <a href="{{ path('admin_product_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Nouveau Produit
                </a>
            </div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-box"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">{{ totalProducts }}</div>
                    <div class="stat-label">Total</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon promo">
                    <i class="fas fa-percentage"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">{{ products|filter(p => p.isPromo)|length }}</div>
                    <div class="stat-label">Promotions</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon new">
                    <i class="fas fa-star"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">{{ products|filter(p => p.isNew)|length }}</div>
                    <div class="stat-label">Nouveautés</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon alert">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-info">
                    <div class="stat-number">{{ products|filter(p => p.stock < 10)|length }}</div>
                    <div class="stat-label">Stock faible</div>
                </div>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-header">
                <i class="fas fa-filter"></i>
                Filtres
            </div>
            <form method="GET" action="{{ path('admin_product_index') }}" class="filter-form">
                <div class="filter-row">
                    <div class="filter-group">
                        <label><i class="fas fa-search"></i> Recherche</label>
                        <input type="text" name="search" value="{{ search }}" 
                               placeholder="Nom du produit...">
                    </div>
                    <div class="filter-group">
                        <label><i class="fas fa-tags"></i> Catégorie</label>
                        <select name="category">
                            <option value="">Toutes</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}" {{ categoryFilter == category.id ? 'selected' : '' }}>
                                    {{ category.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="filter-group">
                        <label><i class="fas fa-sort"></i> Tri</label>
                        <select name="sort">
                            <option value="created_desc" {{ sortFilter == 'created_desc' ? 'selected' : '' }}>Plus récent</option>
                            <option value="name_asc" {{ sortFilter == 'name_asc' ? 'selected' : '' }}>Nom A-Z</option>
                            <option value="price_asc" {{ sortFilter == 'price_asc' ? 'selected' : '' }}>Prix croissant</option>
                            <option value="stock_asc" {{ sortFilter == 'stock_asc' ? 'selected' : '' }}>Stock faible</option>
                        </select>
                    </div>
                    <div class="filter-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i>
                        </button>
                        <a href="{{ path('admin_product_index') }}" class="btn btn-secondary">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <div class="dashboard-card">
            <div class="card-header">
                <i class="fas fa-list"></i>
                Liste des Produits
            </div>
            {% if products|length > 0 %}
                <div class="products-grid" id="productsContainer">
                    {% for product in products %}
                        <div class="product-item">
                            <div class="product-image">
                                {% if product.imageUrl %}
                                    <img src="{{ asset('assets/images/' ~ product.imageUrl) }}" 
                                         alt="{{ product.name }}"
                                         onerror="this.src='{{ asset('assets/images/category-dog.png') }}'">
                                {% else %}
                                    <div class="product-placeholder">
                                        <i class="fas fa-image"></i>
                                    </div>
                                {% endif %}
                                {% if product.isPromo %}
                                    <div class="product-badge promo">PROMO</div>
                                {% endif %}
                                {% if product.isNew %}
                                    <div class="product-badge new">NOUVEAU</div>
                                {% endif %}
                            </div>
                            <div class="product-info">
                                <h4 class="product-name">{{ product.name }}</h4>
                                {% if product.subCategory %}
                                    <div class="product-category">{{ product.subCategory.name }}</div>
                                {% endif %}
                                <div class="product-price">
                                    {% if product.isPromo and product.promoPercentage %}
                                        <span class="old-price">{{ product.price|number_format(2, ',', ' ') }} €</span>
                                        <span class="current-price">{{ product.promotionalPrice|number_format(2, ',', ' ') }} €</span>
                                    {% else %}
                                        <span class="current-price">{{ product.price|number_format(2, ',', ' ') }} €</span>
                                    {% endif %}
                                </div>
                                <div class="product-stock">
                                    <span class="stock-badge {% if product.stock < 5 %}danger{% elseif product.stock < 10 %}warning{% else %}success{% endif %}">
                                        {{ product.stock }} en stock
                                    </span>
                                </div>
                            </div>
                            <div class="product-actions">
                                <a href="{{ path('admin_product_show', {'id': product.id}) }}" class="btn btn-sm btn-outline">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('admin_product_edit', {'id': product.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('admin_product_delete', {'id': product.id}) }}" 
                                      onsubmit="return confirm('Supprimer ce produit ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="pagination-container" id="paginationContainer">
                    <div class="pagination-info">
                        Page <span id="currentPage">1</span> sur <span id="totalPages"></span>
                    </div>
                    <div class="pagination-controls">
                        <button id="prevPage" class="btn btn-sm btn-outline" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button id="nextPage" class="btn btn-sm btn-outline">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <h3>Aucun produit trouvé</h3>
                    <p>{% if search %}Aucun résultat pour "{{ search }}"{% else %}Créez votre premier produit{% endif %}</p>
                    <a href="{{ path('admin_product_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        Nouveau Produit
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
/* Dashboard Container */
.dashboard-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    background: var(--cream, #fdf6e3);
    min-height: 100vh;
}

/* Dashboard Header */
.dashboard-header {
    background: linear-gradient(135deg, var(--primary-orange, #ff8a33) 0%, var(--dark-orange, #e67e22) 100%);
    color: white;
    padding: 2rem;
    border-radius: 15px;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(255, 138, 51, 0.3);
}

.dashboard-title {
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.dashboard-subtitle {
    margin: 0.5rem 0 0 0;
    opacity: 0.9;
    font-size: 1.1rem;
}

.dashboard-actions {
    display: flex;
    gap: 1rem;
}

.dashboard-actions .btn {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
}

.dashboard-actions .btn:hover {
    background: white;
    color: var(--primary-orange, #ff8a33);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.3);
}

/* Dashboard Content */
.dashboard-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

/* Stats Grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: white;
    padding: 1.5rem;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
}

.stat-icon {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    background: var(--primary-orange, #ff8a33);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.5rem;
}

.stat-icon.promo {
    background: #f39c12;
}

.stat-icon.new {
    background: #27ae60;
}

.stat-icon.alert {
    background: #e74c3c;
}

.stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-orange, #ff8a33);
    margin: 0;
}

.stat-label {
    color: #666;
    font-size: 0.9rem;
    margin: 0;
}

/* Dashboard Card */
.dashboard-card {
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
}

.card-header {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 1.5rem;
    border-bottom: 1px solid #eee;
    font-weight: 600;
    color: var(--primary-orange, #ff8a33);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

/* Filter Form */
.filter-form {
    padding: 1.5rem;
}

.filter-row {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr auto;
    gap: 1rem;
    align-items: end;
}

.filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.filter-group label {
    font-weight: 600;
    color: #666;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.filter-group input,
.filter-group select {
    padding: 0.75rem 1rem;
    border: 2px solid #e9ecef;
    border-radius: 10px;
    font-family: var(--font-body, 'Inter', sans-serif);
    transition: all 0.3s ease;
}

.filter-group input:focus,
.filter-group select:focus {
    border-color: var(--primary-orange, #ff8a33);
    box-shadow: 0 0 0 3px rgba(255, 138, 51, 0.1);
    outline: none;
}

.filter-actions {
    display: flex;
    gap: 0.5rem;
}

.filter-actions .btn {
    padding: 0.75rem;
    width: 50px;
    height: 50px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-primary {
    background: var(--primary-orange, #ff8a33);
    color: white;
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
}

/* Products Grid */
.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    padding: 1.5rem;
}

.product-item {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.product-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    border-color: var(--primary-orange, #ff8a33);
}

.product-image {
    position: relative;
    height: 200px;
    overflow: hidden;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.product-item:hover .product-image img {
    transform: scale(1.1);
}

.product-placeholder {
    height: 100%;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 3rem;
}

.product-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
    text-transform: uppercase;
}

.product-badge.promo {
    background: #f39c12;
}

.product-badge.new {
    background: #27ae60;
}

.product-info {
    padding: 1.5rem;
}

.product-name {
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: #333;
    margin: 0 0 0.5rem 0;
}

.product-category {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1rem;
}

.product-price {
    margin-bottom: 1rem;
}

.old-price {
    text-decoration: line-through;
    color: #999;
    font-size: 0.9rem;
    margin-right: 0.5rem;
}

.current-price {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--primary-orange, #ff8a33);
}

.product-stock {
    margin-bottom: 1rem;
}

.stock-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    color: white;
}

.stock-badge.success {
    background: #27ae60;
}

.stock-badge.warning {
    background: #f39c12;
}

.stock-badge.danger {
    background: #e74c3c;
}

.product-actions {
    display: flex;
    gap: 0.5rem;
    padding: 0 1.5rem 1.5rem;
}

.btn-sm {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 2px solid;
    font-weight: 600;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-outline {
    border-color: #ddd;
    color: #666;
    background: white;
}

.btn-outline:hover {
    border-color: var(--primary-orange, #ff8a33);
    color: var(--primary-orange, #ff8a33);
}

.btn-primary {
    border-color: var(--primary-orange, #ff8a33);
    background: var(--primary-orange, #ff8a33);
    color: white;
}

.btn-danger {
    border-color: #e74c3c;
    background: #e74c3c;
    color: white;
}

/* Pagination */
.pagination-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-top: 1px solid #eee;
}

.pagination-info {
    color: #666;
    font-weight: 600;
}

.pagination-controls {
    display: flex;
    gap: 0.5rem;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: #666;
}

.empty-icon {
    font-size: 4rem;
    color: #ddd;
    margin-bottom: 1rem;
}

.empty-state h3 {
    margin-bottom: 0.5rem;
    color: #333;
}

.empty-state p {
    margin-bottom: 2rem;
    font-size: 1.1rem;
}

/* Responsive */
@media (max-width: 768px) {
    .dashboard-container {
        padding: 1rem;
    }
    
    .dashboard-header {
        padding: 1.5rem;
    }
    
    .dashboard-title {
        font-size: 2rem;
    }
    
    .filter-row {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .filter-actions {
        justify-content: center;
    }
    
    .products-grid {
        grid-template-columns: 1fr;
        padding: 1rem;
    }
    
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 480px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .dashboard-actions {
        flex-direction: column;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Pagination JavaScript (8 items per page)
    const productsContainer = document.getElementById('productsContainer');
    const paginationContainer = document.getElementById('paginationContainer');
    const currentPageSpan = document.getElementById('currentPage');
    const totalPagesSpan = document.getElementById('totalPages');
    const prevButton = document.getElementById('prevPage');
    const nextButton = document.getElementById('nextPage');
    
    if (productsContainer && paginationContainer) {
        const products = Array.from(productsContainer.children);
        const itemsPerPage = 8;
        let currentPage = 1;
        const totalPages = Math.ceil(products.length / itemsPerPage);
        
        function showPage(page) {
            products.forEach((product, index) => {
                const startIndex = (page - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                
                if (index >= startIndex && index < endIndex) {
                    product.style.display = 'block';
                } else {
                    product.style.display = 'none';
                }
            });
            
            currentPageSpan.textContent = page;
            totalPagesSpan.textContent = totalPages;
            
            prevButton.disabled = page === 1;
            nextButton.disabled = page === totalPages;
            
            if (page === 1) {
                prevButton.style.opacity = '0.5';
            } else {
                prevButton.style.opacity = '1';
            }
            
            if (page === totalPages) {
                nextButton.style.opacity = '0.5';
            } else {
                nextButton.style.opacity = '1';
            }
        }
        
        prevButton.addEventListener('click', () => {
            if (currentPage > 1) {
                currentPage--;
                showPage(currentPage);
            }
        });
        
        nextButton.addEventListener('click', () => {
            if (currentPage < totalPages) {
                currentPage++;
                showPage(currentPage);
            }
        });
        
        // Initialize
        if (totalPages <= 1) {
            paginationContainer.style.display = 'none';
        }
        showPage(1);
    }
    
    // Auto-submit filters
    const filterForm = document.querySelector('.filter-form');
    if (filterForm) {
        const inputs = filterForm.querySelectorAll('input, select');
        inputs.forEach(input => {
            if (input.type !== 'submit') {
                input.addEventListener('change', () => {
                    filterForm.submit();
                });
            }
        });
        
        // Search with delay
        const searchInput = filterForm.querySelector('input[name="search"]');
        if (searchInput) {
            let timeout;
            searchInput.addEventListener('input', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => {
                    filterForm.submit();
                }, 800);
            });
        }
    }
});
</script>
{% endblock %}
