{# templates/emails/contact_confirmation.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Confirmation de réception de votre message</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background: linear-gradient(135deg, #27AE60, #2ECC71);
            color: white;
            padding: 20px;
            border-radius: 10px 10px 0 0;
            text-align: center;
        }
        .content {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 0 0 10px 10px;
        }
        .highlight {
            background: #E8F8F5;
            padding: 15px;
            border-radius: 5px;
            border-left: 4px solid #27AE60;
            margin: 15px 0;
        }
        .footer {
            text-align: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            color: #666;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>✓ Message bien reçu !</h1>
    </div>
    
    <div class="content">
        <p>Bonjour {{ data.firstName }} {{ data.lastName }},</p>
        
        <p>Nous avons bien reçu votre message concernant "<strong>{{ data.subject }}</strong>" et nous vous en remercions.</p>
        
        <div class="highlight">
            <p><strong>Que se passe-t-il maintenant ?</strong></p>
            <ul>
                <li>Votre message a été transmis à notre équipe</li>
                <li>Nous vous répondrons dans un délai de 24-48h ouvrables</li>
                <li>Vous recevrez notre réponse à l'adresse : {{ data.email }}</li>
            </ul>
        </div>
        
        <p>Voici un récapitulatif de votre message :</p>
        <div style="background: white; padding: 15px; border-radius: 5px; margin: 10px 0;">
            <strong>Sujet :</strong> 
            {% set subjects = {
                'general': 'Question générale',
                'support': 'Support technique',
                'order': 'Commande et livraison',
                'return': 'Retour et remboursement',
                'partnership': 'Partenariat',
                'other': 'Autre'
            } %}
            {{ subjects[data.subject] ?? data.subject }}<br>
            <strong>Message :</strong><br>
            {{ data.message|nl2br }}
        </div>
        
        <p>Si votre demande est urgente, vous pouvez également nous joindre par téléphone au <strong>+33 1 23 45 67 89</strong>.</p>
        
        <p>Cordialement,<br>
        L'équipe de support</p>
    </div>
    
    <div class="footer">
        <p>Cet email a été envoyé automatiquement, merci de ne pas y répondre directement.</p>
        <p>Message envoyé le {{ "now"|date("d/m/Y à H:i") }}</p>
    </div>
</body>
</html>