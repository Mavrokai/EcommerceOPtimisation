<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Nouveau message de contact</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background: linear-gradient(135deg, #E67E22, #D35400);
            color: white;
            padding: 20px;
            border-radius: 10px 10px 0 0;
            text-align: center;
        }
        .content {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 0 0 10px 10px;
        }
        .field {
            margin-bottom: 15px;
        }
        .field-label {
            font-weight: bold;
            color: #E67E22;
        }
        .message-content {
            background: white;
            padding: 15px;
            border-radius: 5px;
            border-left: 4px solid #E67E22;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Nouveau message de contact</h1>
    </div>
    
    <div class="content">
        <div class="field">
            <span class="field-label">Nom :</span> {{ data.firstName }} {{ data.lastName }}
        </div>
        
        <div class="field">
            <span class="field-label">Email :</span> {{ data.email }}
        </div>
        
        {% if data.phone %}
        <div class="field">
            <span class="field-label">Téléphone :</span> {{ data.phone }}
        </div>
        {% endif %}
        
        <div class="field">
            <span class="field-label">Sujet :</span> 
            {% set subjects = {
                'general': 'Question générale',
                'support': 'Support technique',
                'order': 'Commande et livraison',
                'return': 'Retour et remboursement',
                'partnership': 'Partenariat',
                'other': 'Autre'
            } %}
            {{ subjects[data.subject] ?? data.subject }}
        </div>
        
        <div class="field">
            <span class="field-label">Message :</span>
            <div class="message-content">
                {{ data.message|nl2br }}
            </div>
        </div>
        
        <hr>
        <p><small>Message envoyé le {{ "now"|date("d/m/Y à H:i") }}</small></p>
    </div>
</body>
</html>