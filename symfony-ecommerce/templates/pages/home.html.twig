        @media (max-width: 480px) {
            .featured-main-heading {
                font-size: 1.8rem;
                margin-bottom: 0.6rem;
            }
            
            .reviews-heading {
                font-size: 1.6rem;
                margin-bottom: 1.2rem;
            }
            
            .featured-subtitle {
                font-size: 0.95rem;
                margin-bottom: 1.8rem;
            }
            
            .product-image {
                height: 200px;
            }
            
            .product-info {
                padding: 15px;
            }
            
            .product-name {
                font-size: 1rem;
                margin-bottom: 6px;
            }
            
            .product-description {
                font-size: 0.85rem;
                margin-bottom: 12px;
            }
            
            .current-price {
                font-size: 1.2rem;
            }
            
            .btn-view-details-full {
                padding: 12px 20px;
                font-size: 0.9rem;
            }
            
            .customer-reviews-section {
                padding: 1.5rem 0.8rem;
            }
            
            .review-card {
                padding: 1rem;
            }
            
            .customer-avatar {
                width: 40px;
                height: 40px;
                margin-right: 0.8rem;
            }
            
            .customer-name {
                font-size: 0.9rem;
            }
            
