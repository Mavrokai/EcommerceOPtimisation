    </style>
{% endblock %}

{% block body %}
    <div class="page-main-wrapper">
        <section class="banner-hero-area" role="banner">
            {% include 'components/hero_banner.html.twig' with {
                'title': 'Tout pour le bonheur de vos animaux',
                'subtitle': 'Découvrez notre sélection premium de produits pour chiens, chats et bien plus',
                'buttonText': 'Découvrir nos produits',
                'buttonUrl': path('products'),
                'background_image': '{{ asset("assets/images/hero-image.png") }}'
            } %}
        </section>

        <section class="product-category-container" role="region" aria-labelledby="categories-title">
            <h2 id="categories-title" class="category-main-heading">Nos Catégories</h2>
            
            {% if categories is defined and categories|length > 0 %}
                <div class="category-items-layout">
                    {% for category in categories %}
                        <div class="single-category-wrapper">
                            <div class="animated-shape-element gradient-color-{{ loop.index0 % 6 }}"></div>
                            
                            {% include 'components/category_card.html.twig' with {
                                'category': category
                            } %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="category-loading-spinner">
                    <p>Chargement des catégories...</p>
                </div>
            {% endif %}
        </section>

        <!-- Section Produits Phares et Avis Clients -->
        <section class="featured-section" role="region" aria-labelledby="featured-title">
            <div class="featured-container">
                <h2 id="featured-title" class="featured-main-heading">
                    <i class="fas fa-star"></i>
                    Nos Produits Phares
                </h2>
                <p class="featured-subtitle">Découvrez nos bestsellers plébiscités par nos clients</p>
                
                <div class="featured-products-grid">
                    {% if featuredProducts is defined and featuredProducts|length > 0 %}
                        {% for product in featuredProducts %}
                            <div class="featured-product-card">
                                <div class="product-badge {{ product.badge|lower }}">{{ product.badge }}</div>
                                <div class="product-image">
                                    {% set imgRelPath = 'assets/images/' ~ product.image %}
                                    <picture>
                                        <source srcset="{{ asset(imgRelPath|webp_path) }}" type="image/webp">
                                        <img src="{{ asset(imgRelPath) }}"
                                             alt="{{ product.name }}"
                                             onerror="this.src='{{ asset('assets/images/default-product.svg') }}'">
                                    </picture>
                                </div>
                                <div class="product-info">
                                    <h3 class="product-name">{{ product.name }}</h3>
                                    <p class="product-description">{{ product.description }}</p>
                                    <div class="product-rating">
                                        {% for i in 1..5 %}
                                            <i class="fas fa-star {{ i <= product.rating ? 'active' : '' }}"></i>
                                        {% endfor %}
                                        <span class="rating-text">({{ product.reviewCount }} avis)</span>
                                    </div>
                                    <div class="product-price">
                                        {% if product.oldPrice is defined %}
                                            <span class="old-price">{{ product.oldPrice }}€</span>
                                        {% endif %}
                                        <span class="current-price">{{ product.price }}€</span>
                                    </div>
                                    <div class="product-actions">
                                        <a href="{{ path('product_detail', {'id': product.id}) }}" class="btn-view-details-full">
                                            <i class="fas fa-eye"></i>
                                            Voir les détails
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>

                <!-- Section Avis Clients -->
                <div class="customer-reviews-section">
                    <h3 class="reviews-heading">
                        <i class="fas fa-comments"></i>
                        Ce que disent nos clients
                    </h3>
                    <div class="reviews-grid">
                        {% if customerReviews is defined and customerReviews|length > 0 %}
                            {% for review in customerReviews %}
                                <div class="review-card">
                                    <div class="review-header">
                                        <div class="customer-avatar">
                                            {% set avatarRelPath = 'assets/images/' ~ review.avatar %}
                                            <picture>
                                                <source srcset="{{ asset(avatarRelPath|webp_path) }}" type="image/webp">
                                                <img src="{{ asset(avatarRelPath) }}"
                                                     alt="{{ review.name }}"
                                                     onerror="this.src='{{ asset('assets/images/default-avatar.svg') }}'">
                                            </picture>
                                        </div>
                                        <div class="customer-info">
                                            <h4 class="customer-name">{{ review.name }}</h4>
                                            <div class="review-rating">
                                                {% for i in 1..5 %}
                                                    <i class="fas fa-star {{ i <= review.rating ? 'active' : '' }}"></i>
                                                {% endfor %}
                                            </div>
                                        </div>
                                        <span class="review-date">Il y a {{ review.date }}</span>
                                    </div>
                                    <p class="review-comment">"{{ review.comment }}"</p>
                                    <span class="review-product">Produit: {{ review.product }}</span>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        <section class="special-deals-area" role="region" aria-labelledby="promotions-title">
            <h2 id="promotions-title" class="deals-main-title">Offres Spéciales</h2>
            
            {% if promotions is defined and promotions|length > 0 %}
                <div class="deals-grid-layout" role="region" aria-label="Carousel de promotions">
                    <div class="deals-carousel" id="dealsCarousel" aria-live="polite">
                        {% for promotion in promotions %}
                            <div class="promo-grid-item" role="tabpanel" aria-label="Promotion {{ loop.index }} : {{ promotion.title }}">
                                {% include 'components/promo_card.html.twig' with {
                                    'promotion': promotion,
                                    'size': promotion.size
                                } %}
                            </div>
                        {% endfor %}
                    </div>
                    
                    <div class="carousel-controls" role="toolbar" aria-label="Contrôles du carousel">
                        <button class="carousel-btn" id="prevBtn" aria-label="Promotion précédente (navigation circulaire)" type="button">
                            <svg viewBox="0 0 24 24" fill="currentColor" role="img" aria-hidden="true">
                                <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                            </svg>
                        </button>
                        <button class="carousel-btn" id="nextBtn" aria-label="Promotion suivante (navigation circulaire)" type="button">
                            <svg viewBox="0 0 24 24" fill="currentColor" role="img" aria-hidden="true">
                                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                            </svg>
                        </button>
                    </div>
                    
                    <div class="carousel-dots" id="carouselDots"></div>
                </div>
            {% else %}
                <div class="deals-loading-spinner">
                    <p>Chargement des promotions...</p>
                </div>
            {% endif %}
        </section>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const promoImages = document.querySelectorAll('.promo-card img');
            
            if ('IntersectionObserver' in window) {
                const imageObserver = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            if (img.dataset.src) {
                                img.src = img.dataset.src;
                                img.removeAttribute('data-src');
                                observer.unobserve(img);
                            }
                        }
                    });
                });

                promoImages.forEach(img => imageObserver.observe(img));
            }

            const promoCards = document.querySelectorAll('.promo-card');
            promoCards.forEach(card => {
                card.addEventListener('click', function() {
                    const title = this.querySelector('h3')?.textContent || 'Unknown';
                    console.log(`Promotion clicked: ${title}`);
                    
                    
                    if (typeof gtag !== 'undefined') {
                        gtag('event', 'promotion_click', {
                            'promotion_name': title,
                            'page_location': window.location.href
                        });
                    }
                });
            });

            
            const categoryCards = document.querySelectorAll('.category-card');
            categoryCards.forEach(card => {
                // Interactions souris/touch
                const addInteraction = (event) => {
                    card.style.transform = 'translateY(-8px) scale(1.02)';
                };
                
                const removeInteraction = (event) => {
                    card.style.transform = 'translateY(0) scale(1)';
                };
                
                // Événements souris
                card.addEventListener('mouseenter', addInteraction);
                card.addEventListener('mouseleave', removeInteraction);
                
                // Événements touch pour mobile
                card.addEventListener('touchstart', addInteraction, { passive: true });
                card.addEventListener('touchend', removeInteraction, { passive: true });
                card.addEventListener('touchcancel', removeInteraction, { passive: true });
            });

            const allImages = document.querySelectorAll('img');
            allImages.forEach(img => {
                img.addEventListener('error', function() {
                    if (this.classList.contains('category-image')) {
                        this.src = '{{ asset("assets/images/category-dog.png") }}';
                        this.alt = 'Image de catégorie non disponible';
                    }
                    else if (this.classList.contains('promo-image')) {
                        this.src = '{{ asset("assets/images/promo-image.png") }}';
                        this.alt = 'Image de promotion non disponible';
                    }
                    else {
                        this.src = '{{ asset("assets/images/category-dog.png") }}';
                        this.alt = 'Image non disponible';
                    }
                });
            });

            if ('PerformanceObserver' in window) {
                const observerPerf = new PerformanceObserver((list) => {
                    const entries = list.getEntries();
                    entries.forEach(entry => {
                        if (entry.entryType === 'largest-contentful-paint') {
                            console.log('LCP:', entry.startTime);
                        }
                    });
                });
                
                observerPerf.observe({ entryTypes: ['largest-contentful-paint'] });
            }

            
            const carousel = document.getElementById('dealsCarousel');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const dotsContainer = document.getElementById('carouselDots');
            
            if (carousel && prevBtn && nextBtn) {
                const items = carousel.querySelectorAll('.promo-grid-item');
                const totalItems = items.length;
                let currentIndex = 0;
                
                
                // Gestion responsive du carousel
                const getItemsPerView = () => {
                    const containerWidth = carousel.parentElement.offsetWidth;
                    const itemWidth = window.innerWidth <= 480 ? 200 : 
                                     window.innerWidth <= 600 ? 220 :
                                     window.innerWidth <= 768 ? 240 :
                                     window.innerWidth <= 1024 ? 250 : 280;
                    const gap = 24;
                    return Math.max(1, Math.floor((containerWidth - 64) / (itemWidth + gap)));
                };
                
                let itemsPerView = getItemsPerView();
                const maxIndex = Math.max(0, totalItems - itemsPerView);
                
                
                const createDots = () => {
                    dotsContainer.innerHTML = '';
                    for (let i = 0; i <= maxIndex; i++) {
                        const dot = document.createElement('div');
                        dot.className = 'carousel-dot';
                        if (i === 0) dot.classList.add('active');
                        dot.addEventListener('click', () => goToSlide(i));
                        dotsContainer.appendChild(dot);
                    }
                };
                
                
                const updateCarousel = () => {
                    const itemWidth = window.innerWidth <= 480 ? 200 : 
                                     window.innerWidth <= 600 ? 220 :
                                     window.innerWidth <= 768 ? 240 :
                                     window.innerWidth <= 1024 ? 250 : 280;
                    const gap = 24;
                    const offset = currentIndex * (itemWidth + gap);
                    carousel.style.transform = `translateX(-${offset}px)`;
                    
                    
                    document.querySelectorAll('.carousel-dot').forEach((dot, index) => {
                        dot.classList.toggle('active', index === currentIndex);
                    });
                    
                    prevBtn.disabled = false;
                    nextBtn.disabled = false;
                };
                
                const goToSlide = (index) => {
                    currentIndex = Math.max(0, Math.min(index, maxIndex));
                    updateCarousel();
                };
                
                const nextSlide = () => {
                    if (currentIndex < maxIndex) {
                        currentIndex++;
                    } else {
                        currentIndex = 0; 
                    }
                    updateCarousel();
                };
                
                const prevSlide = () => {
                    if (currentIndex > 0) {
                        currentIndex--;
                    } else {
                        currentIndex = maxIndex; 
                    }
                    updateCarousel();
                };
                
                nextBtn.addEventListener('click', nextSlide);
                prevBtn.addEventListener('click', prevSlide);
                
                let autoPlayInterval;
                const startAutoPlay = () => {
                    autoPlayInterval = setInterval(() => {
                        if (currentIndex >= maxIndex) {
                            currentIndex = 0;
                        } else {
                            currentIndex++;
                        }
                        updateCarousel();
                    }, 6000);
                };
                
                const stopAutoPlay = () => {
                    clearInterval(autoPlayInterval);
                };
                
                
                carousel.addEventListener('mouseenter', stopAutoPlay);
                carousel.addEventListener('mouseleave', startAutoPlay);
                
                let startX = 0;
                let endX = 0;
                
                carousel.addEventListener('touchstart', (e) => {
                    startX = e.touches[0].clientX;
                });
                
                carousel.addEventListener('touchend', (e) => {
                    endX = e.changedTouches[0].clientX;
                    const diff = startX - endX;
                    
                    if (Math.abs(diff) > 50) { 
                        if (diff > 0) {
                            nextSlide(); 
                        } else {
                            prevSlide();
                        }
                    }
                });
                
                createDots();
                updateCarousel();
                startAutoPlay();
                
                window.addEventListener('resize', () => {
                    const newItemsPerView = getItemsPerView();
                    if (newItemsPerView !== itemsPerView) {
                        itemsPerView = newItemsPerView;
                        const newMaxIndex = Math.max(0, totalItems - itemsPerView);
                        currentIndex = Math.min(currentIndex, newMaxIndex);
                        createDots();
                        updateCarousel();
                    }
                });
            }
        });

        
        let resizeTimeout;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(function() {
                const dealsGridLayout = document.querySelector('.deals-grid-layout');
                if (dealsGridLayout) {
                    dealsGridLayout.style.display = 'none';
                    dealsGridLayout.offsetHeight;
                    dealsGridLayout.style.display = 'grid';
                }
            }, 250);
        });
    </script>
{% endblock %}
