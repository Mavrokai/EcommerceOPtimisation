{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | Clochette&CO{% endblock %}
{% block meta_description %}{{ product.description|striptags|slice(0, 160) }}{% endblock %}
{% block og_type %}product{% endblock %}
{% block og_title %}{{ product.name }} | Clochette&CO{% endblock %}
{% block og_description %}{{ product.description|striptags|slice(0, 200) }}{% endblock %}
{% block og_image %}{{ app.request.schemeAndHttpHost ~ asset('assets/images/' ~ product.imageUrl) }}{% endblock %}

{% block head_extra %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ product.name|escape('js') }}",
  "description": "{{ product.description|striptags|escape('js') }}",
  "image": "{{ app.request.schemeAndHttpHost ~ asset('assets/images/' ~ product.imageUrl) }}",
  "offers": {
    "@type": "Offer",
    "price": "{{ product.price }}",
    "priceCurrency": "EUR",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Clochette&CO"
    }
  }
}
</script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
:root {
    --primary-orange: #ff8c42;
    --secondary-orange: #ff7b2e;
    --dark-orange: #ff6b1a;
    --light-orange: #fff8f0;
    --text-dark: #2c3e50;
    --text-light: #6c757d;
    --bg-light: #f8f9fa;
    --white: #ffffff;
    --shadow-light: rgba(0, 0, 0, 0.08);
    --shadow-medium: rgba(0, 0, 0, 0.15);
    --border-light: #e9ecef;
    --success-green: #28a745;
    --error-red: #dc3545;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #f6f3e1;
    min-height: 100vh;
    color: var(--text-dark);
    line-height: 1.6;
}

.container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 30px 20px;
}

/* Navigation de retour */
.back-navigation {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
    color: var(--text-light);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.3s ease;
}

.back-navigation:hover {
    color: var(--primary-orange);
}

.back-navigation svg {
    width: 16px;
    height: 16px;
}

/* Layout principal du produit */
.product-detail {
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 8px 40px var(--shadow-light);
    border: 1px solid var(--border-light);
    overflow: hidden;
    margin-bottom: 40px;
}

.product-layout {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 0;
    min-height: 500px;
}

/* Image du produit */
.product-image {
    background: linear-gradient(135deg, var(--bg-light) 0%, #f1f3f4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.product-image img {
    width: 80%;
    height: 80%;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.product-image:hover img {
    transform: scale(1.05);
}

/* Info du produit */
.product-info {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.product-tags {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.product-tag {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.product-tag.new {
    background: linear-gradient(135deg, var(--success-green) 0%, #20c997 100%);
    color: var(--white);
}

.product-tag.promo {
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
}

.product-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 15px;
    line-height: 1.2;
}

.product-price {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary-orange);
    margin-bottom: 20px;
}

.product-stock {
    margin-bottom: 25px;
}

.stock-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
}

.stock-status.in-stock {
    background: rgba(40, 167, 69, 0.1);
    color: var(--success-green);
}

.stock-status.out-of-stock {
    background: rgba(220, 53, 69, 0.1);
    color: var(--error-red);
}

.stock-status svg {
    width: 16px;
    height: 16px;
}

/* Poids du produit */
.product-weight {
    margin-bottom: 25px;
}

.weight-info {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    background: rgba(108, 117, 125, 0.1);
    color: #6c757d;
}

.weight-info svg {
    width: 16px;
    height: 16px;
}

/* Formulaire d'achat */
.purchase-form {
    margin-bottom: 30px;
}

.form-group {
    margin-bottom: 20px;
}

.form-label {
    display: block;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 8px;
    font-size: 14px;
}

.quantity-select {
    width: 100px;
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    background: var(--white);
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.3s ease;
}

.quantity-select:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.btn-primary {
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
}

.btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.4s ease;
}

.btn-primary:hover::before {
    left: 100%;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 140, 66, 0.4);
}

.btn-primary:disabled {
    background: var(--text-light);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

.btn-primary:disabled::before {
    display: none;
}

/* Description du produit */
.product-description {
    background: rgba(255, 140, 66, 0.03);
    padding: 25px;
    border-radius: 16px;
    border: 1px solid rgba(255, 140, 66, 0.1);
}

.product-description h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.product-description h3::before {
    content: '';
    width: 4px;
    height: 24px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    border-radius: 2px;
}

.product-description p {
    color: var(--text-light);
    line-height: 1.7;
    font-size: 15px;
}

/* Section des commentaires */
.comments-section {
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 8px 40px var(--shadow-light);
    border: 1px solid var(--border-light);
    overflow: hidden;
}

.comments-header {
    padding: 30px 40px;
    border-bottom: 1px solid var(--border-light);
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.02) 0%, rgba(255, 255, 255, 1) 100%);
}

.comments-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.comments-title svg {
    width: 24px;
    height: 24px;
    color: var(--primary-orange);
}

.comments-subtitle {
    color: var(--text-light);
    font-size: 14px;
}

/* Formulaire de commentaire */
.comment-form {
    padding: 30px 40px;
    border-bottom: 1px solid var(--border-light);
    background: var(--bg-light);
}

.comment-form h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 20px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 20px;
    margin-bottom: 20px;
}

.form-input {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    font-family: inherit;
    transition: all 0.3s ease;
    background: var(--white);
}

.form-input:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.rating-select {
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    background: var(--white);
    cursor: pointer;
    transition: all 0.3s ease;
}

.rating-select:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.form-textarea {
    width: 100%;
    min-height: 120px;
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    font-family: inherit;
    resize: vertical;
    transition: all 0.3s ease;
    background: var(--white);
    margin-bottom: 20px;
}

.form-textarea:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.btn-comment {
    padding: 12px 24px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-comment:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 140, 66, 0.3);
}

/* Liste des commentaires */
.comments-list {
    padding: 0 40px 40px;
}

.comment-item {
    padding: 25px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.comment-item:last-child {
    border-bottom: none;
}

.comment-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
}

.comment-author {
    display: flex;
    align-items: center;
    gap: 12px;
}

.author-avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
}

.author-info {
    display: flex;
    flex-direction: column;
}

.author-name {
    font-weight: 700;
    color: var(--text-dark);
    font-size: 15px;
}

.comment-date {
    color: var(--text-light);
    font-size: 13px;
}

.comment-rating {
    display: flex;
    gap: 2px;
}

.star {
    color: #ffc107;
    font-size: 16px;
}

.star.empty {
    color: var(--border-light);
}

.comment-text {
    color: var(--text-light);
    line-height: 1.6;
    font-size: 14px;
}

/* Messages d'état */
.message {
    padding: 15px 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-weight: 600;
}

.message.success {
    background: rgba(40, 167, 69, 0.1);
    color: var(--success-green);
    border: 1px solid rgba(40, 167, 69, 0.2);
}

.message.error {
    background: rgba(220, 53, 69, 0.1);
    color: var(--error-red);
    border: 1px solid rgba(220, 53, 69, 0.2);
}

/* État vide */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-light);
}

.empty-state svg {
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    opacity: 0.3;
}

/* Responsive Design */

/* Tablettes */
@media (max-width: 1024px) {
    .container {
        padding: 20px 15px;
    }
    
    .product-layout {
        grid-template-columns: 350px 1fr;
    }
    
    .product-info {
        padding: 30px;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding-left: 30px;
        padding-right: 30px;
    }
}

/* Tablettes portrait */
@media (max-width: 768px) {
    .container {
        padding: 15px 10px;
    }
    
    .product-layout {
        grid-template-columns: 1fr;
        min-height: auto;
    }
    
    .product-image {
        height: 300px;
    }
    
    .product-info {
        padding: 25px;
    }
    
    .product-title {
        font-size: 2rem;
    }
    
    .product-price {
        font-size: 1.8rem;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding: 20px 25px;
    }
    
    .comment-form {
        padding-bottom: 25px;
    }
    
    .form-row {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    
    .comment-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
}

/* Mobiles */
@media (max-width: 480px) {
    .container {
        padding: 10px 5px;
    }
    
    .product-detail, .comments-section {
        border-radius: 16px;
    }
    
    .product-image {
        height: 250px;
    }
    
    .product-info {
        padding: 20px;
    }
    
    .product-title {
        font-size: 1.8rem;
    }
    
    .product-price {
        font-size: 1.6rem;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding: 15px 20px;
    }
    
    .comment-author {
        gap: 10px;
    }
    
    .author-avatar {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }
    
    .btn-primary {
        padding: 14px 20px;
        font-size: 15px;
    }
}

/* Très petits mobiles */
@media (max-width: 360px) {
    .product-info {
        padding: 15px;
    }
    
    .product-title {
        font-size: 1.6rem;
    }
    
    .product-price {
        font-size: 1.4rem;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding: 12px 15px;
    }
}
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <!-- Navigation de retour -->
    <a href="{{ path('homepage') }}" class="back-navigation">
        <svg fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
        </svg>
        Retour à la boutique
    </a>

    <!-- Détail du produit -->
    <div class="product-detail">
        <div class="product-layout">
            <!-- Image du produit -->
            <div class="product-image">
                {% if product.imageUrl and product.imageUrl is not empty %}
                    {% set imgRelPath = 'assets/images/' ~ product.imageUrl %}
                    <picture>
                        <source srcset="{{ asset(imgRelPath|webp_path) }}" type="image/webp">
                        <img src="{{ asset(imgRelPath) }}"
                             alt="{{ product.name }}"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                             style="max-width: 100%; max-height: 100%; object-fit: contain;">
                    </picture>
                    <!-- Fallback SVG (caché par défaut) -->
                    <svg width="200" height="200" viewBox="0 0 200 200" fill="none" style="display: none;">
                        <rect width="200" height="200" fill="#f1f3f4"/>
                        <path d="M67 130L97 100L127 130L157 100L187 130V170H13V130L43 100L67 130Z" fill="#dee2e6"/>
                        <circle cx="73" cy="57" r="17" fill="#dee2e6"/>
                        <text x="100" y="190" text-anchor="middle" fill="#6c757d" font-size="12">{{ product.name }}</text>
                    </svg>
                {% else %}
                    <!-- Image par défaut quand aucune image n'est définie -->
                    <svg width="200" height="200" viewBox="0 0 200 200" fill="none">
                        <rect width="200" height="200" fill="#f1f3f4"/>
                        <path d="M67 130L97 100L127 130L157 100L187 130V170H13V130L43 100L67 130Z" fill="#dee2e6"/>
                        <circle cx="73" cy="57" r="17" fill="#dee2e6"/>
                        <text x="100" y="190" text-anchor="middle" fill="#6c757d" font-size="12">{{ product.name }}</text>
                    </svg>
                {% endif %}
            </div>

            <!-- Informations du produit -->
            <div class="product-info">
                <div>
                    <!-- Tags -->
                    <div class="product-tags">
                        {% if product.isNew|default(false) %}
                            <span class="product-tag new">Nouveau</span>
                        {% endif %}
                        {% if product.isOnSale|default(false) %}
                            <span class="product-tag promo">Promo</span>
                        {% endif %}
                    </div>

                    <!-- Titre et prix -->
                    <h1 class="product-title">{{ product.name }}</h1>
                    <div class="product-price">${{ product.price }}</div>

                    <!-- Stock -->
                    <div class="product-stock">
                        {% if product.stock > 0 %}
                            <span class="stock-status in-stock">
                                <svg fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                </svg>
                                En stock ({{ product.stock }} disponibles)
                            </span>
                        {% else %}
                            <span class="stock-status out-of-stock">
                                <svg fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                </svg>
                                Rupture de stock
                            </span>
                        {% endif %}
                    </div>

                    <!-- Poids du produit -->
                    {% if product.weight %}
                        <div class="product-weight">
                            <span class="weight-info">
                                <svg fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M6 2a1 1 0 000 2h8a1 1 0 100-2H6zM3 6a1 1 0 011-1h12a1 1 0 011 1v8a1 1 0 01-1 1H4a1 1 0 01-1-1V6zm2 2v6h10V8H5z"/>
                                </svg>
                                Poids : {{ product.weight }} kg
                            </span>
                        </div>
                    {% endif %}

                    <!-- Formulaire d'achat -->
                    {% if product.stock > 0 %}
                        <form action="{{ path('app_cart_add', {'id': product.id}) }}" method="post" class="purchase-form">
                            <div class="form-group">
                                <label for="quantity" class="form-label">Quantité</label>
                                <select name="quantity" id="quantity" class="quantity-select">
                                    {% for i in 1..(product.stock > 10 ? 10 : product.stock) %}
                                        <option value="{{ i }}">{{ i }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <!-- Description -->
                        {% if product.description %}
                            <div class="product-description">
                                <h3>Description du produit</h3>
                                <p>{{ product.description }}</p>
                            </div>
                        {% endif %}
                            
                            <button type="submit" class="btn-primary">
                                Ajouter au panier
                            </button>
                        </form>
                    {% else %}
                        <button class="btn-primary" disabled>
                            Produit indisponible
                        </button>
                    {% endif %}
                </div>

                
            </div>
        </div>
    </div>

    <!-- Section des commentaires -->
    <div class="comments-section">
        <!-- En-tête des commentaires -->
        <div class="comments-header">
            <h2 class="comments-title">
                <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
                </svg>
                Avis clients
            </h2>
            <p class="comments-subtitle">Partagez votre expérience avec ce produit</p>
        </div>

        <!-- Formulaire d'ajout de commentaire -->
        <div class="comment-form">
            <h3>Laisser un avis</h3>
            
            <!-- Messages de retour -->
            {% for message in app.flashes('comment_success') %}
                <div class="message success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('comment_error') %}
                <div class="message error">{{ message }}</div>
            {% endfor %}
            
            <form action="{{ path('app_product_comment', {'id': product.id}) }}" method="post">
                <div class="form-row">
                    <input type="text" name="author_name" placeholder="Votre nom" class="form-input" required>
                    <select name="rating" class="rating-select" required>
                        <option value="">Note</option>
                        <option value="5">★★★★★ (5 étoiles)</option>
                        <option value="4">★★★★☆ (4 étoiles)</option>
                        <option value="3">★★★☆☆ (3 étoiles)</option>
                        <option value="2">★★☆☆☆ (2 étoiles)</option>
                        <option value="1">★☆☆☆☆ (1 étoile)</option>
                    </select>
                </div>
                
                <textarea name="comment_text" placeholder="Partagez votre expérience avec ce produit..." class="form-textarea" required></textarea>
                
                <button type="submit" class="btn-comment">Publier mon avis</button>
            </form>
        </div>

        <!-- Liste des commentaires -->
        <div class="comments-list">
            {% if product.comments is defined and product.comments|length > 0 %}
                {% for comment in product.comments|reverse %}
                    <div class="comment-item">
                        <div class="comment-header">
                            <div class="comment-author">
                                <div class="author-avatar">
                                    {{ comment.authorName|first|upper }}
                                </div>
                                <div class="author-info">
                                    <div class="author-name">{{ comment.authorName }}</div>
                                    <div class="comment-date">{{ comment.createdAt|date('d/m/Y à H:i') }}</div>
                                </div>
                            </div>
                            <div class="comment-rating">
                                {% for i in 1..5 %}
                                    <span class="star {% if i <= comment.rating %}filled{% else %}empty{% endif %}">★</span>
                                {% endfor %}
                            </div>
                        </div>
                        <p class="comment-text">{{ comment.content }}</p>
                    </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
                    </svg>
                    <p>Aucun avis pour le moment</p>
                    <p>Soyez le premier à donner votre avis sur ce produit !</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
// Mise à jour du compteur du panier après ajout
document.addEventListener('DOMContentLoaded', function() {
    const addToCartForm = document.querySelector('.purchase-form');
    if (addToCartForm) {
        addToCartForm.addEventListener('submit', function(e) {
            // Après soumission du formulaire, on attend un peu puis on met à jour le compteur
            setTimeout(updateCartCounter, 500);
        });
    }
});

function updateCartCounter() {
    if (window.updateCartCounter) {
        window.updateCartCounter();
    } else {
        fetch('/cart-count')
            .then(response => response.json())
            .then(data => {
                const counter = document.getElementById('cart-counter');
                if (counter) {
                    if (data.count > 0) {
                        counter.textContent = data.count;
                        counter.style.display = 'flex';
                        counter.classList.add('bounce');
                        setTimeout(() => counter.classList.remove('bounce'), 600);
                    } else {
                        counter.style.display = 'none';
                        counter.textContent = '';
                    }
                }
            })
            .catch(error => console.log('Erreur compteur:', error));
    }
}
</script>
{% endblock %}
