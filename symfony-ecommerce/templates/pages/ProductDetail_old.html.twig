{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Détails du produit{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
:root {
    --primary-orange: #ff8c42;
    --secondary-orange: #ff7b2e;
    --dark-orange: #ff6b1a;
    --light-orange: #fff8f0;
    --text-dark: #2c3e50;
    --text-light: #6c757d;
    --bg-light: #f8f9fa;
    --white: #ffffff;
    --shadow-light: rgba(0, 0, 0, 0.08);
    --shadow-medium: rgba(0, 0, 0, 0.15);
    --border-light: #e9ecef;
    --success-green: #28a745;
    --error-red: #dc3545;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #f6f3e1;
    min-height: 100vh;
    color: var(--text-dark);
    line-height: 1.6;
}

.container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 30px 20px;
}

/* Navigation de retour */
.back-navigation {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
    color: var(--text-light);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.3s ease;
}

.back-navigation:hover {
    color: var(--primary-orange);
}

.back-navigation svg {
    width: 16px;
    height: 16px;
}

/* Layout principal du produit */
.product-detail {
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 8px 40px var(--shadow-light);
    border: 1px solid var(--border-light);
    overflow: hidden;
    margin-bottom: 40px;
}

.product-layout {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 0;
    min-height: 500px;
}

/* Image du produit */
.product-image {
    background: linear-gradient(135deg, var(--bg-light) 0%, #f1f3f4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.product-image img {
    width: 80%;
    height: 80%;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.product-image:hover img {
    transform: scale(1.05);
}

/* Info du produit */
.product-info {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.product-tags {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.product-tag {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.product-tag.new {
    background: linear-gradient(135deg, var(--success-green) 0%, #20c997 100%);
    color: var(--white);
}

.product-tag.promo {
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
}

.product-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 15px;
    line-height: 1.2;
}

.product-price {
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary-orange);
    margin-bottom: 20px;
}

.product-stock {
    margin-bottom: 25px;
}

.stock-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
}

.stock-status.in-stock {
    background: rgba(40, 167, 69, 0.1);
    color: var(--success-green);
}

.stock-status.out-of-stock {
    background: rgba(220, 53, 69, 0.1);
    color: var(--error-red);
}

.stock-status svg {
    width: 16px;
    height: 16px;
}

/* Formulaire d'achat */
.purchase-form {
    margin-bottom: 30px;
}

.form-group {
    margin-bottom: 20px;
}

.form-label {
    display: block;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 8px;
    font-size: 14px;
}

.quantity-select {
    width: 100px;
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    background: var(--white);
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.3s ease;
}

.quantity-select:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.btn-primary {
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
}

.btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.4s ease;
}

.btn-primary:hover::before {
    left: 100%;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 140, 66, 0.4);
}

.btn-primary:disabled {
    background: var(--text-light);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

.btn-primary:disabled::before {
    display: none;
}

/* Description du produit */
.product-description {
    background: rgba(255, 140, 66, 0.03);
    padding: 25px;
    border-radius: 16px;
    border: 1px solid rgba(255, 140, 66, 0.1);
}

.product-description h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.product-description h3::before {
    content: '';
    width: 4px;
    height: 24px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    border-radius: 2px;
}

.product-description p {
    color: var(--text-light);
    line-height: 1.7;
    font-size: 15px;
}

/* Section des commentaires */
.comments-section {
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 8px 40px var(--shadow-light);
    border: 1px solid var(--border-light);
    overflow: hidden;
}

.comments-header {
    padding: 30px 40px;
    border-bottom: 1px solid var(--border-light);
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.02) 0%, rgba(255, 255, 255, 1) 100%);
}

.comments-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.comments-title svg {
    width: 24px;
    height: 24px;
    color: var(--primary-orange);
}

.comments-subtitle {
    color: var(--text-light);
    font-size: 14px;
}

/* Formulaire de commentaire */
.comment-form {
    padding: 30px 40px;
    border-bottom: 1px solid var(--border-light);
    background: var(--bg-light);
}

.comment-form h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 20px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 20px;
    margin-bottom: 20px;
}

.form-input {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    font-family: inherit;
    transition: all 0.3s ease;
    background: var(--white);
}

.form-input:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.rating-select {
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    background: var(--white);
    cursor: pointer;
    transition: all 0.3s ease;
}

.rating-select:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.form-textarea {
    width: 100%;
    min-height: 120px;
    padding: 12px 16px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    font-family: inherit;
    resize: vertical;
    transition: all 0.3s ease;
    background: var(--white);
    margin-bottom: 20px;
}

.form-textarea:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.btn-comment {
    padding: 12px 24px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-comment:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 140, 66, 0.3);
}

/* Liste des commentaires */
.comments-list {
    padding: 0 40px 40px;
}

.comment-item {
    padding: 25px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.comment-item:last-child {
    border-bottom: none;
}

.comment-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
}

.comment-author {
    display: flex;
    align-items: center;
    gap: 12px;
}

.author-avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
}

.author-info {
    display: flex;
    flex-direction: column;
}

.author-name {
    font-weight: 700;
    color: var(--text-dark);
    font-size: 15px;
}

.comment-date {
    color: var(--text-light);
    font-size: 13px;
}

.comment-rating {
    display: flex;
    gap: 2px;
}

.star {
    color: #ffc107;
    font-size: 16px;
}

.star.empty {
    color: var(--border-light);
}

.comment-text {
    color: var(--text-light);
    line-height: 1.6;
    font-size: 14px;
}

/* Messages d'état */
.message {
    padding: 15px 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-weight: 600;
}

.message.success {
    background: rgba(40, 167, 69, 0.1);
    color: var(--success-green);
    border: 1px solid rgba(40, 167, 69, 0.2);
}

.message.error {
    background: rgba(220, 53, 69, 0.1);
    color: var(--error-red);
    border: 1px solid rgba(220, 53, 69, 0.2);
}

/* État vide */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-light);
}

.empty-state svg {
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    opacity: 0.3;
}

/* Responsive Design */

/* Tablettes */
@media (max-width: 1024px) {
    .container {
        padding: 20px 15px;
    }
    
    .product-layout {
        grid-template-columns: 350px 1fr;
    }
    
    .product-info {
        padding: 30px;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding-left: 30px;
        padding-right: 30px;
    }
}

/* Tablettes portrait */
@media (max-width: 768px) {
    .container {
        padding: 15px 10px;
    }
    
    .product-layout {
        grid-template-columns: 1fr;
        min-height: auto;
    }
    
    .product-image {
        height: 300px;
    }
    
    .product-info {
        padding: 25px;
    }
    
    .product-title {
        font-size: 2rem;
    }
    
    .product-price {
        font-size: 1.8rem;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding: 20px 25px;
    }
    
    .comment-form {
        padding-bottom: 25px;
    }
    
    .form-row {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    
    .comment-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
}

/* Mobiles */
@media (max-width: 480px) {
    .container {
        padding: 10px 5px;
    }
    
    .product-detail, .comments-section {
        border-radius: 16px;
    }
    
    .product-image {
        height: 250px;
    }
    
    .product-info {
        padding: 20px;
    }
    
    .product-title {
        font-size: 1.8rem;
    }
    
    .product-price {
        font-size: 1.6rem;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding: 15px 20px;
    }
    
    .comment-author {
        gap: 10px;
    }
    
    .author-avatar {
        width: 40px;
        height: 40px;
        font-size: 16px;
    }
    
    .btn-primary {
        padding: 14px 20px;
        font-size: 15px;
    }
}

/* Très petits mobiles */
@media (max-width: 360px) {
    .product-info {
        padding: 15px;
    }
    
    .product-title {
        font-size: 1.6rem;
    }
    
    .product-price {
        font-size: 1.4rem;
    }
    
    .comments-header, .comment-form, .comments-list {
        padding: 12px 15px;
    }
}
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="product-detail">
        <div class="product-image">
        </div>
        
        <div class="product-info">
            {% if product.isNew %}
                <span class="product-tag new">New</span>
            {% elseif product.isPromo %}
                <span class="product-tag promo">Promo</span>
            {% endif %}
            
            <div class="product-price">${{ product.price }}</div>
            <h1 class="product-title">{{ product.name }}</h1>
            
            <div class="product-stock">
                {% if product.stock is defined and product.stock > 0 %}
                    <span class="in-stock">In Stock ({{ product.stock }} available)</span>
                {% elseif product.stock is defined and product.stock == 0 %}
                    <span class="out-of-stock">Out of Stock</span>
                {% else %}
                    <span class="in-stock">In Stock</span>
                {% endif %}
            </div>
            
            <div class="product-labels">
                <form action="{{ path('app_cart_add', {id: product.id}) }}" method="POST" id="add-to-cart-form">
                    <div class="form-group">
                        <label for="quantity">Quantity</label>
                        <select id="quantity" name="quantity">
                            {% for i in 1..10 %}
                                {% if product.stock is defined and product.stock > 0 %}
                                    {% if i <= product.stock %}
                                        <option value="{{ i }}">{{ i }}</option>
                                    {% endif %}
                                {% else %}
                                    <option value="{{ i }}">{{ i }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                
                    {% if product.stock is defined and product.stock > 0 %}
                        <button type="submit" class="btn-primary">Add to Cart</button>
                    {% elseif product.stock is defined and product.stock == 0 %}
                        <button class="btn-primary" disabled>Out of Stock</button>
                    {% else %}
                        <button type="submit" class="btn-primary">Add to Cart</button>
                    {% endif %}
                </form>
            </div>
            
            {% if product.description %}
                <div class="product-description">
                    <h3>Description</h3>
                    <p>{{ product.description }}</p>
                </div>
            {% endif %}
        </div>
    </div>
    
    <div class="ratings-section">
        <div class="ratings-header">
            <h2>Customer Reviews</h2>
            
            <div class="ratings-summary">
                <div class="average-rating">
                    <div class="rating-number">{{ reviews.average|default('4.5') }}</div>
                    <div class="rating-stars">
                        {% for i in 1..5 %}
                            <span class="star {{ i <= (reviews.average|default(4.5)) ? '' : 'empty' }}">★</span>
                        {% endfor %}
                    </div>
                    <div class="total-reviews">{{ reviews.total|default('127') }} reviews</div>
                </div>
                
                <div class="rating-breakdown">
                    {% set breakdown = reviews.breakdown|default({5: 85, 4: 25, 3: 12, 2: 3, 1: 2}) %}
                    {% set total = reviews.total|default(127) %}
                    {% for rating in 5..1 %}
                        <div class="rating-row">
                            <span class="rating-label" data-rating="{{ rating }}">{{ rating }}</span>
                            <div class="rating-bar">
                                <div class="rating-fill" style="width: {{ (breakdown[rating]/total*100)|default(0) }}%"></div>
                            </div>
                            <span class="rating-count">{{ breakdown[rating]|default(0) }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        
        <div class="customer-reviews">
            <div class="reviews-header">
                <h3>Recent Reviews</h3>
            </div>
            
            {% set sample_reviews = [
                {
                    'name': 'Sarah Johnson',
                    'rating': 5,
                    'date': '2 days ago',
                    'text': 'Absolutely love this product! The quality exceeded my expectations and it arrived quickly. Highly recommended for anyone looking for reliability and great value.'
                },
                {
                    'name': 'Mike Chen',
                    'rating': 4,
                    'date': '1 week ago',
                    'text': 'Great product overall. Very satisfied with the purchase. Only minor issue was the packaging, but the product itself is excellent quality.'
                },
                {
                    'name': 'Emma Davis',
                    'rating': 5,
                    'date': '2 weeks ago',
                    'text': 'Perfect! Exactly what I was looking for. Fast shipping and excellent customer service. Will definitely buy from this store again.'
                }
            ] %}
            
            {% for review in reviews.items|default(sample_reviews) %}
                <div class="review-item">
                    <div class="review-header">
                        <div class="reviewer-info">
                            <div class="reviewer-avatar">
                                {{ review.name|first }}
                            </div>
                            <div>
                                <div class="reviewer-name">{{ review.name }}</div>
                                <div class="review-date">{{ review.date }}</div>
                            </div>
                        </div>
                        
                        <div class="review-rating">
                            {% for i in 1..5 %}
                                <span class="star {{ i <= review.rating ? '' : 'empty' }}">★</span>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <div class="review-text">
                        {{ review.text }}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>



function updateCartCounter() {
    if (window.updateCartCounter) {
        window.updateCartCounter();
    } else {
        fetch('/cart-count')
            .then(response => response.json())
            .then(data => {
                const counter = document.getElementById('cart-counter');
                if (counter) {
                    if (data.count > 0) {
                        counter.textContent = data.count;
                        counter.style.display = 'flex';
                        counter.classList.add('bounce');
                        setTimeout(() => counter.classList.remove('bounce'), 600);
                    } else {
                        counter.style.display = 'none';
                        counter.textContent = '';
                    }
                }
            })
            .catch(error => console.log('Erreur compteur:', error));
    }
}
</script>
{% endblock %}

