{% extends 'base.html.twig' %}
{% block title %}Tous nos produits pour animaux | Clochette&CO{% endblock %}
{% block meta_description %}Parcourez notre catalogue complet de produits pour animaux : chiens, chats, oiseaux, lézards. Alimentation, jouets, accessoires et soins au meilleur prix.{% endblock %}
{% block stylesheets %}
{{ parent() }}
    <style>
:root {
    --primary-orange: #ff8c42;
    --secondary-orange: #ff7b2e;
    --dark-orange: #ff6b1a;
    --light-orange: #fff8f0;
    --text-dark: #2c3e50;
    --text-light: #6c757d;
    --bg-light: #f8f9fa;
    --white: #ffffff;
    --shadow-light: rgba(0, 0, 0, 0.08);
    --shadow-medium: rgba(0, 0, 0, 0.15);
    --border-light: #e9ecef;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #f6f3e1;
    min-height: 100vh;
    color: var(--text-dark);
}

.product-page-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 30px 20px;
}

.page-header {
    text-align: center;
    margin-bottom: 40px;
    position: relative;
}

.page-header::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, var(--primary-orange)20 0%, transparent 70%);
    border-radius: 50%;
    z-index: -1;
}

.main-title {
    font-size: 3rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
    letter-spacing: -2px;
}

.subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    font-weight: 400;
}

/* Layout principal avec sidebar */
.main-content {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 30px;
    align-items: start;
}

/* SIDEBAR STYLES */
.filters-sidebar {
    background: var(--white);
    border-radius: 20px;
    padding: 35px;
    box-shadow: 0 8px 30px var(--shadow-light);
    border: 1px solid var(--border-light);
    position: sticky;
    top: 30px;
    max-height: calc(100vh - 60px);
    overflow-y: auto;
}

.sidebar-header {
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--border-light);
}

.sidebar-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-dark);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
}

.filter-icon-svg {
    width: 24px;
    height: 24px;
    color: var(--primary-orange);
}

/* BOUTON FILTRES MOBILE */
.mobile-filters-toggle {
    display: none;
    width: 100%;
    padding: 15px 20px;
    background: var(--white);
    border: 2px solid var(--border-light);
    border-radius: 16px;
    margin-bottom: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-dark);
    box-shadow: 0 4px 15px var(--shadow-light);
}

.mobile-filters-toggle:hover {
    border-color: var(--primary-orange);
    background: rgba(255, 140, 66, 0.02);
}

.mobile-filters-toggle.active {
    border-color: var(--primary-orange);
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
}

.mobile-filters-toggle .filter-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.mobile-filters-toggle .toggle-text {
    flex: 1;
    text-align: left;
}

.mobile-filters-toggle .chevron-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
}

.mobile-filters-toggle.active .chevron-icon {
    transform: rotate(180deg);
}

.sidebar-section {
    margin-bottom: 30px;
    padding-bottom: 25px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.sidebar-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
}

.section-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.section-title::before {
    content: '';
    width: 4px;
    height: 20px;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    border-radius: 2px;
}

/* Search styles pour sidebar */
.search-container {
    position: relative;
    width: 100%;
}

.search-input {
    width: 100%;
    padding: 12px 40px 12px 15px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    transition: all 0.3s ease;
    background: var(--bg-light);
}

.search-input:focus {
    outline: none;
    border-color: var(--primary-orange);
    background: var(--white);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

.search-icon {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
    width: 18px;
    height: 18px;
    pointer-events: none;
}

/* Sort select pour sidebar */
.sort-select {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid var(--border-light);
    border-radius: 12px;
    font-size: 14px;
    background: var(--white);
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.3s ease;
}

.sort-select:focus {
    outline: none;
    border-color: var(--primary-orange);
    box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.1);
}

/* Categories verticales */
.categories-vertical {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.category-item-vertical {
    width: 100%;
}

.category-btn-vertical {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 15px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 12px;
    width: 100%;
    text-align: left;
    position: relative;
}

.category-btn-vertical:hover {
    background: rgba(255, 140, 66, 0.05);
    transform: translateX(4px);
}

.category-btn-vertical.active {
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    transform: translateX(4px);
    box-shadow: 0 4px 15px rgba(255, 140, 66, 0.3);
}

.category-icon-vertical {
    width: 36px;
    height: 36px;
    background: rgba(255, 140, 66, 0.1);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.category-btn-vertical.active .category-icon-vertical {
    background: rgba(255, 255, 255, 0.2);
}

.category-btn-vertical.active .dropdown-arrow-vertical {
    color: var(--white);
    opacity: 1;
}

.category-image-vertical {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
}

.category-name-vertical {
    font-size: 14px;
    font-weight: 600;
    flex: 1;
}

.dropdown-arrow-vertical {
    width: 18px;
    height: 18px;
    opacity: 0.7;
    transition: transform 0.3s ease;
    margin-left: auto;
    flex-shrink: 0;
    color: var(--text-light);
}

/* Sous-catégories */
.subcategories-list {
    margin-top: 8px;
    margin-left: 20px;
    display: none;
    flex-direction: column;
    gap: 4px;
    border-left: 2px solid rgba(255, 140, 66, 0.2);
    padding-left: 15px;
}

.category-item-vertical.expanded .subcategories-list {
    display: flex;
}

/* Sous-catégories normalement cachées */

.category-item-vertical.expanded .dropdown-arrow-vertical {
    transform: rotate(180deg);
}

.subcategory-btn-vertical {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 8px;
    width: 100%;
    text-align: left;
}

.subcategory-btn-vertical:hover {
    background: rgba(255, 140, 66, 0.08);
    transform: translateX(2px);
}

.subcategory-btn-vertical.active {
    background: linear-gradient(135deg, rgba(255, 140, 66, 0.9) 0%, rgba(255, 123, 46, 0.9) 100%);
    color: var(--white);
}

.subcategory-icon-vertical {
    width: 24px;
    height: 24px;
    background: rgba(255, 140, 66, 0.1);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
    color: var(--primary-orange);
}

.subcategory-btn-vertical.active .subcategory-icon-vertical {
    background: rgba(255, 255, 255, 0.2);
    color: var(--white);
}

.subcategory-content-vertical {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.subcategory-name-vertical {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 2px;
}

.subcategory-count-vertical {
    font-size: 11px;
    opacity: 0.7;
    font-weight: 500;
}

/* CONTENU PRINCIPAL */
.products-content {
    min-height: 500px;
}

.products-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding: 20px 25px;
    background: var(--white);
    border-radius: 16px;
    box-shadow: 0 4px 15px var(--shadow-light);
    border: 1px solid var(--border-light);
}

.products-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-dark);
    margin: 0;
}

.results-info {
    color: var(--text-light);
    font-size: 14px;
    font-weight: 500;
    padding: 8px 16px;
    background: var(--bg-light);
    border-radius: 20px;
    border: 1px solid var(--border-light);
}

/* Modern Product Grid */
.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 25px;
    margin-bottom: 40px;
}

.product-card {
    background: #f8e2bf;
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border: 1px solid var(--border-light);
    position: relative;
    cursor: pointer;
}

.product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, transparent 0%, rgba(255, 140, 66, 0.03) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    border-color: var(--primary-orange);
}

.product-card:hover::before {
    opacity: 1;
}

.product-image {
    width: 100%;
    height: 240px;
    background: linear-gradient(135deg, var(--bg-light) 0%, #f1f3f4 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.product-card:hover .product-image img {
    transform: scale(1.05);
}

.product-content {
    padding: 25px;
}

.product-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 8px;
    line-height: 1.3;
}

.product-price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--primary-orange);
    margin-bottom: 12px;
}

.product-description {
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.product-actions {
    display: flex;
    gap: 12px;
    align-items: center;
}

.cart-form-desktop {
    display: inline-block;
}

.cart-form-mobile {
    display: none;
}

.btn-text-desktop {
    display: inline;
}

.btn-text-mobile {
    display: none;
}

.btn {
    padding: 12px 24px;
    border: none;
    border-radius: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: relative;
    overflow: hidden;
}

.btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.4s ease;
}

.btn:hover::before {
    left: 100%;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    flex: 1;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 140, 66, 0.3);
}

.btn-secondary {
    background: var(--bg-light);
    color: var(--text-dark);
    border: 2px solid var(--border-light);
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
}

.btn-secondary svg {
    width: 20px;
    height: 20px;
    transition: transform 0.2s ease;
}

.btn-secondary:hover {
    background: var(--primary-orange);
    color: var(--white);
    border-color: var(--primary-orange);
    transform: translateY(-2px) scale(1.05);
}

.btn-secondary:hover svg {
    transform: scale(1.1);
}

/* Style alternatif pour mobile avec texte */
.btn-secondary-mobile {
    display: none;
    background: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
    color: var(--white);
    border: none;
    padding: 10px 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 13px;
    min-width: 120px;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.btn-secondary-mobile:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 140, 66, 0.3);
}

.btn-secondary-mobile svg {
    width: 16px;
    height: 16px;
}

/* Modern Pagination */
.pagination-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin: 40px 0;
    padding: 20px;
    background: var(--white);
    border-radius: 16px;
    box-shadow: 0 4px 15px var(--shadow-light);
    border: 1px solid var(--border-light);
}

.pagination-btn {
    padding: 12px 20px;
    background: var(--white);
    border: 2px solid var(--border-light);
    border-radius: 12px;
    color: var(--text-dark);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 48px;
    text-align: center;
}

.pagination-btn:hover:not(:disabled) {
    background: var(--primary-orange);
    color: var(--white);
    border-color: var(--primary-orange);
    transform: translateY(-2px);
}

.pagination-btn.active {
    background: var(--primary-orange);
    color: var(--white);
    border-color: var(--primary-orange);
}

.pagination-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.pagination-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 8px;
    color: var(--text-light);
    font-weight: 600;
    user-select: none;
}

@media (max-width: 768px) {
    .pagination-dots {
        padding: 8px 4px;
        font-size: 14px;
    }
}

/* Responsive Design */

/* Extra Large Screens */
@media (max-width: 1400px) {
    .product-page-wrapper {
        max-width: 1300px;
        padding: 25px 20px;
    }
    
    .main-content {
        grid-template-columns: 360px 1fr;
        gap: 25px;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }
}

/* Large Tablets et petits ordinateurs portables */
@media (max-width: 1200px) {
    .product-page-wrapper {
        max-width: 1200px;
        padding: 25px 20px;
    }
    
    .main-content {
        grid-template-columns: 340px 1fr;
        gap: 22px;
    }
    
    .filters-sidebar {
        padding: 28px;
        border-radius: 18px;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 18px;
    }
    
    .main-title {
        font-size: 2.8rem;
    }
    
    .product-image {
        height: 220px;
    }
}

/* Tablettes moyennes */
@media (max-width: 1024px) {
    .product-page-wrapper {
        padding: 20px 15px;
    }
    
    .main-content {
        grid-template-columns: 300px 1fr;
        gap: 18px;
    }
    
    .filters-sidebar {
        padding: 22px;
        border-radius: 16px;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 16px;
    }
    
    .products-header {
        padding: 16px 18px;
    }
    
    .products-title {
        font-size: 1.5rem;
    }
    
    .main-title {
        font-size: 2.5rem;
    }
    
    .subtitle {
        font-size: 1rem;
    }
    
    .product-image {
        height: 200px;
    }
    
    .product-content {
        padding: 20px;
    }
    
    .category-btn-vertical {
        padding: 10px 12px;
    }
    
    .category-icon-vertical {
        width: 32px;
        height: 32px;
    }
}

/* Tablettes portrait et petites tablettes */
@media (max-width: 900px) {
    .main-content {
        grid-template-columns: 260px 1fr;
        gap: 15px;
    }
    
    .filters-sidebar {
        padding: 18px;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 14px;
    }
    
    .sidebar-title {
        font-size: 1.3rem;
    }
    
    .section-title {
        font-size: 0.95rem;
    }
    
    .main-title {
        font-size: 2.2rem;
    }
    
    .product-image {
        height: 180px;
    }
    
    .product-title {
        font-size: 1.1rem;
    }
    
    .product-price {
        font-size: 1.3rem;
    }
}

/* Tablettes portrait et grands mobiles */
@media (max-width: 768px) {
    .product-page-wrapper {
        padding: 15px 12px;
    }
    
    .main-content {
        grid-template-columns: 1fr;
        gap: 0;
    }
    
    /* Afficher le bouton mobile */
    .mobile-filters-toggle {
        display: flex;
        margin-bottom: 15px;
    }
    
    /* Sidebar en mode déroulant avec animations améliorées */
    .filters-sidebar {
        position: static;
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        margin-bottom: 0;
        padding: 0 20px;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateY(-10px);
        box-shadow: none;
    }
    
    .filters-sidebar.show {
        max-height: 90vh;
        opacity: 1;
        margin-bottom: 20px;
        padding: 20px;
        transform: translateY(0);
        box-shadow: 0 8px 30px var(--shadow-medium);
        overflow-y: auto;
    }
    
    .sidebar-header {
        margin-bottom: 18px;
        padding-bottom: 12px;
    }
    
    .sidebar-section {
        margin-bottom: 18px;
        padding-bottom: 12px;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 12px;
    }
    
    .product-image {
        height: 170px;
    }
    
    .product-content {
        padding: 18px;
    }
    
    .products-header {
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
        text-align: center;
        padding: 14px 18px;
        border-radius: 14px;
        margin-bottom: 20px;
    }
    
    .products-title {
        font-size: 1.4rem;
    }
    
    .main-title {
        font-size: 2rem;
        letter-spacing: -1px;
    }
    
    .subtitle {
        font-size: 0.95rem;
    }
    
    .pagination-wrapper {
        flex-wrap: wrap;
        gap: 6px;
        padding: 12px;
        border-radius: 14px;
    }
    
    .pagination-btn {
        padding: 8px 14px;
        min-width: 36px;
        font-size: 13px;
        border-radius: 10px;
    }
    
    /* Sidebar responsive */
    .category-btn-vertical {
        padding: 10px 12px;
        border-radius: 10px;
    }
    
    .category-icon-vertical {
        width: 30px;
        height: 30px;
    }
    
    .category-name-vertical {
        font-size: 13px;
    }
    
    .subcategory-btn-vertical {
        padding: 8px 10px;
        border-radius: 8px;
    }
    
    .search-input, .sort-select {
        padding: 10px 12px;
        font-size: 13px;
        border-radius: 10px;
    }
    
    .product-actions {
        gap: 8px;
    }
    
    .btn-primary {
        padding: 10px 18px;
        font-size: 13px;
    }
    
    .btn-secondary {
        width: 42px;
        height: 42px;
    }
}

/* Mobiles paysage et tablettes mini */
@media (max-width: 640px) {
    .product-page-wrapper {
        padding: 12px 10px;
    }
    
    .mobile-filters-toggle {
        padding: 12px 16px;
        font-size: 14px;
        border-radius: 12px;
        margin-bottom: 12px;
    }
    
