{% block body %}
<div class="product-page-wrapper">
    <div class="main-content">
        <!-- Bouton filtres mobile -->
        <button class="mobile-filters-toggle" id="mobileFiltersToggle">
            <svg class="filter-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/>
            </svg>
            <span class="toggle-text">Filtres & Recherche</span>
            <svg class="chevron-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 10l5 5 5-5z"/>
            </svg>
        </button>

        <!-- Sidebar gauche -->
        <aside class="filters-sidebar">
            <div class="sidebar-header">
                <h3 class="sidebar-title">
                    <svg class="filter-icon-svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/>
                    </svg>
                    Filtres & Recherche
                </h3>
            </div>

            <!-- Recherche -->
            <div class="sidebar-section">
                <h4 class="section-title">Rechercher</h4>
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Rechercher un produit..." id="searchInput">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                    </svg>
                </div>
            </div>

            <!-- Tri -->
            <div class="sidebar-section">
                <h4 class="section-title">Trier par</h4>
                <select class="sort-select" id="sortSelect">
                    <option value="default">Pertinence</option>
                    <option value="price-asc">Prix croissant</option>
                    <option value="price-desc">Prix décroissant</option>
                    <option value="name-asc">Nom A-Z</option>
                    <option value="name-desc">Nom Z-A</option>
                    <option value="newest">Plus récent</option>
                </select>
            </div>

            <!-- Catégories -->
            <div class="sidebar-section">
                <h4 class="section-title">Catégories</h4>
                <div class="categories-vertical" id="categoriesSection">
                    <div class="category-item-vertical" data-category-id="all">
                        <button class="category-btn-vertical active" data-category="all" data-type="all">
                            <div class="category-icon-vertical">
                                <picture>
                                    <source srcset="{{ asset('assets/images/hero-image.png'|webp_path) }}" type="image/webp">
                                    <img src="{{ asset('assets/images/hero-image.png') }}" alt="Tous les produits" class="category-image-vertical">
                                </picture>
                            </div>
                            <span class="category-name-vertical">Tous les produits</span>
                        </button>
                    </div>
                    
                    {% for category in categories %}
                        <div class="category-item-vertical" data-category-id="{{ category.id }}">
                            <button class="category-btn-vertical" data-category="{{ category.id }}" data-type="category">
                                <div class="category-icon-vertical">
                                    {% if category.image %}
                                        {% set imgRelPath = 'assets/images/' ~ category.image %}
                                    {% else %}
                                        {% if category.name|lower == 'chiens' %}
                                            {% set imgRelPath = 'assets/images/category-dog.png' %}
                                        {% elseif category.name|lower == 'chats' %}
                                            {% set imgRelPath = 'assets/images/category-cat.png' %}
                                        {% elseif category.name|lower == 'oiseaux' %}
                                            {% set imgRelPath = 'assets/images/category-bird.png' %}
                                        {% else %}
                                            {% set imgRelPath = 'assets/images/category-dog.png' %}
                                        {% endif %}
                                    {% endif %}

                                    <picture>
                                        <source srcset="{{ asset(imgRelPath|webp_path) }}" type="image/webp">
                                        <img
                                            src="{{ asset(imgRelPath) }}"
                                            alt="{{ category.name }}"
                                            class="category-image-vertical"
                                            loading="lazy"
                                            onerror="this.src='{{ asset('assets/images/category-dog.png') }}'">
                                    </picture>
                                </div>
                                <span class="category-name-vertical">{{ category.name }}</span>
                                {% if category.subCategories is not empty %}
                                    <svg class="dropdown-arrow-vertical" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M7 10l5 5 5-5z"/>
                                    </svg>
                                {% endif %}
                            </button>
                            
                            {% if category.subCategories is not empty %}
                                <div class="subcategories-list">
                                    {% for subCategory in category.subCategories %}
                                        <button class="subcategory-btn-vertical" data-category="{{ subCategory.id }}" data-type="subcategory" data-parent="{{ category.id }}">
                                            <div class="subcategory-icon-vertical">
                                                📌
                                            </div>
                                            <div class="subcategory-content-vertical">
                                                <span class="subcategory-name-vertical">{{ subCategory.name }}</span>
                                                <span class="subcategory-count-vertical">{{ subCategory.products|length }} articles</span>
                                            </div>
                                        </button>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </aside>

        <!-- Contenu principal -->
        <main class="products-content">
            <div class="products-header">
                <h1 class="products-title">Nos Produits</h1>
                <div class="results-info" id="resultsInfo">
                    {{ products|length }} produit{{ products|length > 1 ? 's' : '' }} trouvé{{ products|length > 1 ? 's' : '' }}
                </div>
            </div>

            <div class="products-grid" id="productsGrid">
        {% for product in products %}
            <div class="product-card" 
                 data-category="{{ product.subCategory ? product.subCategory.category.id : 'all' }}" 
                 data-subcategory="{{ product.subCategory ? product.subCategory.id : 'all' }}">
                <div class="product-image">
                    {% if product.imageUrl and product.imageUrl is not empty %}
                        {% set imgRelPath = 'assets/images/' ~ product.imageUrl %}
                    {% else %}
                        {% set imgRelPath = 'assets/images/hero-image.png' %}
                    {% endif %}
                    <picture>
                        <source srcset="{{ asset(imgRelPath|webp_path) }}" type="image/webp">
                        <img src="{{ asset(imgRelPath) }}" alt="{{ product.name }}" loading="lazy">
                    </picture>
                </div>
                <div class="product-content">
                    <h3 class="product-title">{{ product.name }}</h3>
                    <div class="product-price">{{ product.price }}€</div>
                    <p class="product-description">{{ product.description }}</p>
                    <div class="product-actions">
                        <a href="{{ path('product_detail', {id: product.id}) }}" class="btn btn-primary">
                            <span class="btn-text-desktop">Voir plus de détails</span>
                            <span class="btn-text-mobile">Détails</span>
                        </a>
                        
                        <!-- Bouton panier desktop (circulaire) -->
                        <form action="{{ path('app_cart_add', {id: product.id}) }}" method="POST" class="cart-form-desktop">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="btn btn-secondary" title="Ajouter au panier">
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"></path>
                                </svg>
                            </button>
                        </form>
                        
                        <!-- Bouton panier mobile (avec texte) -->
                        <form action="{{ path('app_cart_add', {id: product.id}) }}" method="POST" class="cart-form-mobile">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="btn btn-secondary-mobile" title="Ajouter au panier">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"></path>
                                </svg>
                                <span>Ajouter</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
            </div>

            <div class="pagination-wrapper" id="paginationContainer">
                <button class="pagination-btn" id="prevBtn">Précédent</button>
                <div id="pageNumbers"></div>
                <button class="pagination-btn" id="nextBtn">Suivant</button>
            </div>
        </main>
    </div>
</div>    <script>
        document.addEventListener('DOMContentLoaded', function() {
        const productsGrid = document.getElementById('productsGrid');
        const productCards = Array.from(productsGrid.querySelectorAll('.product-card'));
        const resultsInfo = document.getElementById('resultsInfo');
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        
        // Gestion des paramètres URL de la navbar (lecture seule)
        const urlParams = new URLSearchParams(window.location.search);
        const navbarCategory = '{{ navbarCategory ?? '' }}';
        const navbarSubcategory = '{{ navbarSubcategory ?? '' }}';
        
        // Gestion du menu déroulant mobile avec améliorations
        const mobileFiltersToggle = document.getElementById('mobileFiltersToggle');
        const filtersSidebar = document.querySelector('.filters-sidebar');
        
        if (mobileFiltersToggle && filtersSidebar) {
            mobileFiltersToggle.addEventListener('click', function() {
                const isActive = this.classList.contains('active');
                
                if (isActive) {
                    // Fermer
                    this.classList.remove('active');
                    filtersSidebar.classList.remove('show');
                } else {
                    // Ouvrir
                    this.classList.add('active');
                    filtersSidebar.classList.add('show');
                    
                    // Scroll vers les filtres sur mobile
                    if (window.innerWidth <= 768) {
                        setTimeout(() => {
                            filtersSidebar.scrollIntoView({ 
                                behavior: 'smooth', 
                                block: 'start' 
                            });
                        }, 100);
                    }
                }
            });
            
            // Fermer automatiquement si on clique ailleurs (mobile uniquement)
            document.addEventListener('click', function(e) {
                if (window.innerWidth <= 768) {
                    if (!mobileFiltersToggle.contains(e.target) && !filtersSidebar.contains(e.target)) {
                        mobileFiltersToggle.classList.remove('active');
                        filtersSidebar.classList.remove('show');
                    }
                }
            });
            
            // Gérer le redimensionnement de fenêtre
            let resizeTimeout;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(() => {
                    if (window.innerWidth > 768) {
                        mobileFiltersToggle.classList.remove('active');
                        filtersSidebar.classList.remove('show');
                    }
                }, 150);
            });
            
            // Fermer les filtres après sélection sur mobile
            const categoryButtons = document.querySelectorAll('.category-btn-vertical, .subcategory-btn-vertical');
            categoryButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (window.innerWidth <= 768) {
                        setTimeout(() => {
                            mobileFiltersToggle.classList.remove('active');
                            filtersSidebar.classList.remove('show');
                        }, 300);
                    }
                });
            });
        }
        
        // Gestion des catégories avec expansion/réduction
        const categoryItems = document.querySelectorAll('.category-item-vertical');
        
        categoryItems.forEach(item => {
            const categoryBtn = item.querySelector('.category-btn-vertical');
            const subcategoriesList = item.querySelector('.subcategories-list');
            const dropdownArrow = item.querySelector('.dropdown-arrow-vertical');
            
            if (categoryBtn && subcategoriesList) {
                categoryBtn.addEventListener('click', function(e) {
                    // Si c'est un clic sur la flèche, on gère l'expansion
                    if (e.target === dropdownArrow || dropdownArrow?.contains(e.target)) {
                        e.stopPropagation();
                        item.classList.toggle('expanded');
                        return;
                    }
                    
                    // Sinon, on gère la sélection de catégorie
                    handleCategorySelection(categoryBtn);
                });
                
                // Clic sur la flèche pour expand/collapse
                if (dropdownArrow) {
                    dropdownArrow.addEventListener('click', function(e) {
                        e.stopPropagation();
                        item.classList.toggle('expanded');
                    });
                }
                
                // Gestionnaires pour les sous-catégories
                const subcategoryButtons = item.querySelectorAll('.subcategory-btn-vertical');
                subcategoryButtons.forEach(subBtn => {
                    subBtn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        handleCategorySelection(subBtn);
                    });
                });
            } else if (categoryBtn) {
                categoryBtn.addEventListener('click', function() {
                    handleCategorySelection(categoryBtn);
                });
            }
        });
        
        const itemsPerPage = 9; 
        let currentPage = 1;
        let filteredProducts = [];
        let activeCategory = 'all';
        let activeSubCategory = null;

        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const pageNumbers = document.getElementById('pageNumbers');

        function getVisibleProducts() {
            return productCards.filter(card => card.style.display !== 'none');
        }

        function updatePagination() {
            filteredProducts = getVisibleProducts();
            const totalPages = Math.ceil(filteredProducts.length / itemsPerPage);
            
            pageNumbers.innerHTML = '';
            
            // Sur mobile, afficher moins de pages pour éviter le débordement
            const isMobile = window.innerWidth <= 768;
            const maxVisiblePages = isMobile ? 3 : 5;
            
            let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
            let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
            
            if (endPage - startPage + 1 < maxVisiblePages) {
                startPage = Math.max(1, endPage - maxVisiblePages + 1);
            }
            
            // Bouton "première page" si nécessaire
            if (startPage > 1 && !isMobile) {
                const firstBtn = document.createElement('button');
                firstBtn.className = 'pagination-btn';
                firstBtn.textContent = '1';
                firstBtn.addEventListener('click', () => {
                    currentPage = 1;
                    showCurrentPage();
                });
                pageNumbers.appendChild(firstBtn);
                
                if (startPage > 2) {
                    const dotsSpan = document.createElement('span');
                    dotsSpan.textContent = '...';
                    dotsSpan.className = 'pagination-dots';
                    pageNumbers.appendChild(dotsSpan);
                }
            }
            
            // Pages visibles
            for (let i = startPage; i <= endPage; i++) {
                const pageBtn = document.createElement('button');
                pageBtn.className = 'pagination-btn';
                pageBtn.textContent = i;
                if (i === currentPage) {
                    pageBtn.classList.add('active');
                }
                pageBtn.addEventListener('click', () => {
                    currentPage = i;
                    showCurrentPage();
                });
                pageNumbers.appendChild(pageBtn);
            }
            
            // Bouton "dernière page" si nécessaire
            if (endPage < totalPages && !isMobile) {
                if (endPage < totalPages - 1) {
                    const dotsSpan = document.createElement('span');
                    dotsSpan.textContent = '...';
                    dotsSpan.className = 'pagination-dots';
                    pageNumbers.appendChild(dotsSpan);
                }
                
                const lastBtn = document.createElement('button');
                lastBtn.className = 'pagination-btn';
                lastBtn.textContent = totalPages;
                lastBtn.addEventListener('click', () => {
                    currentPage = totalPages;
                    showCurrentPage();
                });
                pageNumbers.appendChild(lastBtn);
            }
            
            prevBtn.disabled = currentPage === 1;
            nextBtn.disabled = currentPage === totalPages || totalPages === 0;
            showCurrentPage();
        }

        function handleCategorySelection(btn) {
            const filterType = btn.getAttribute('data-type');
            const categoryId = btn.getAttribute('data-category');
            
            // Retirer la classe active de tous les boutons
            const allCategoryButtons = document.querySelectorAll('.category-btn-vertical, .subcategory-btn-vertical');
            allCategoryButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            // Mettre à jour les variables de filtrage
            if (filterType === 'all') {
                activeCategory = 'all';
                activeSubCategory = null;
            } else if (filterType === 'category') {
                activeCategory = categoryId;
                activeSubCategory = null;
            } else if (filterType === 'subcategory') {
                activeCategory = null;
                activeSubCategory = categoryId;
            }
            
            currentPage = 1; 
            filterAndSort();
        }

        // Optimisation des performances - Debounce pour la recherche
        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }

        // Recherche avec debounce
        const debouncedSearch = debounce(function() {
            currentPage = 1; 
            filterAndSort();
        }, 300);

        searchInput.addEventListener('input', debouncedSearch);

        // Amélioration des interactions tactiles
        function addTouchSupport(element) {
            element.addEventListener('touchstart', function(e) {
                this.style.transform = 'scale(0.98)';
            }, { passive: true });
            
            element.addEventListener('touchend', function(e) {
                this.style.transform = '';
            }, { passive: true });
        }

        // Appliquer le support tactile aux boutons principaux
        document.querySelectorAll('.btn, .pagination-btn, .category-btn-vertical, .subcategory-btn-vertical').forEach(addTouchSupport);

        // Gestion du scroll vers le haut après changement de page
        function showCurrentPage() {
            productCards.forEach(card => {
                card.style.display = 'none';
            });
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const productsToShow = filteredProducts.slice(startIndex, endIndex);
            productsToShow.forEach(card => {
                card.style.display = '';
            });

            const pageButtons = pageNumbers.querySelectorAll('.pagination-btn');
            pageButtons.forEach((btn, index) => {
                const pageNum = parseInt(btn.textContent);
                btn.classList.toggle('active', pageNum === currentPage);
            });
            
            const totalVisible = filteredProducts.length;
            const startItem = totalVisible === 0 ? 0 : startIndex + 1;
            const endItem = Math.min(endIndex, totalVisible);
            
            resultsInfo.textContent = `Affichage de ${startItem}-${endItem} sur ${totalVisible} produit${totalVisible > 1 ? 's' : ''}`;
            
            // Scroll fluide vers le haut de la grille de produits sur changement de page
            if (currentPage > 1) {
                const productsHeader = document.querySelector('.products-header');
                if (productsHeader) {
                    productsHeader.scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'start',
                        inline: 'nearest'
                    });
                }
            }
        }

        sortSelect.addEventListener('change', function() {
            filterAndSort();
        });

        prevBtn.addEventListener('click', () => {
            if (currentPage > 1) {
                currentPage--;
                showCurrentPage();
            }
        });

        nextBtn.addEventListener('click', () => {
            const totalPages = Math.ceil(filteredProducts.length / itemsPerPage);
            if (currentPage < totalPages) {
                currentPage++;
                showCurrentPage();
            }
        });

        function filterAndSort() {
            const searchValue = searchInput.value.trim().toLowerCase();
            
            productCards.forEach(card => {
                const categoryId = card.getAttribute('data-category');
                const subCategoryId = card.getAttribute('data-subcategory');
                const title = card.querySelector('.product-title').textContent.toLowerCase();
                const desc = card.querySelector('.product-description').textContent.toLowerCase();
                
                let show = true;
                
                if (activeCategory === 'all') {
                    show = true;
                } else if (activeSubCategory) {
                    show = (subCategoryId === activeSubCategory);
                } else if (activeCategory) {
                    show = (categoryId === activeCategory);
                }
                
                if (searchValue && show) {
                    show = show && (title.includes(searchValue) || desc.includes(searchValue));
                }
                
                card.style.display = show ? '' : 'none';
            });

            let visible = getVisibleProducts();
            let sortType = sortSelect.value;
            let sorted = visible.slice();
            
            if (sortType === 'price-asc') {
                sorted.sort((a, b) => parseFloat(a.querySelector('.product-price').textContent) - parseFloat(b.querySelector('.product-price').textContent));
            } else if (sortType === 'price-desc') {
                sorted.sort((a, b) => parseFloat(b.querySelector('.product-price').textContent) - parseFloat(a.querySelector('.product-price').textContent));
            } else if (sortType === 'name-asc') {
                sorted.sort((a, b) => a.querySelector('.product-title').textContent.localeCompare(b.querySelector('.product-title').textContent));
            } else if (sortType === 'name-desc') {
                sorted.sort((a, b) => b.querySelector('.product-title').textContent.localeCompare(a.querySelector('.product-title').textContent));
            }
            
            sorted.forEach(card => productsGrid.appendChild(card));
            updatePagination();
        }

        // Initialiser avec les paramètres de la navbar si présents, sinon tous les produits
        function initializeFromNavbar() {
            if (navbarCategory && navbarSubcategory) {
                // Venu depuis navbar avec sous-catégorie - appliquer le filtrage
                activeCategory = null;
                activeSubCategory = findSubcategoryIdBySlug(navbarCategory, navbarSubcategory);
                
                console.log('Filtrage navbar sous-catégorie:', activeSubCategory);
                
                // Activer visuellement la sous-catégorie dans la sidebar
                if (activeSubCategory) {
                    const subCatBtn = document.querySelector(`[data-category="${activeSubCategory}"][data-type="subcategory"]`);
                    if (subCatBtn) {
                        const allButtons = document.querySelectorAll('.category-btn-vertical, .subcategory-btn-vertical');
                        allButtons.forEach(b => b.classList.remove('active'));
                        subCatBtn.classList.add('active');
                        
                        // Expand la catégorie parent
                        const parentItem = subCatBtn.closest('.category-item-vertical');
                        if (parentItem) {
                            parentItem.classList.add('expanded');
                        }
                    }
                }
            } else if (navbarCategory) {
                // Venu depuis navbar avec catégorie uniquement - appliquer le filtrage
                activeCategory = findCategoryIdBySlug(navbarCategory);
                activeSubCategory = null;
                
                console.log('Filtrage navbar catégorie:', activeCategory);
                
                // Activer visuellement la catégorie dans la sidebar
                if (activeCategory) {
                    const catBtn = document.querySelector(`[data-category="${activeCategory}"][data-type="category"]`);
                    if (catBtn) {
                        const allButtons = document.querySelectorAll('.category-btn-vertical, .subcategory-btn-vertical');
                        allButtons.forEach(b => b.classList.remove('active'));
                        catBtn.classList.add('active');
                    }
                }
            } else {
                // Affichage normal - tous les produits
                activeCategory = 'all';
                activeSubCategory = null;
            }
        }
        
        // Générer les mappings dynamiquement à partir des données du serveur
        const categoryMapping = {};
        const subcategoryMapping = {};
        
        {% for category in categories %}
            categoryMapping['{{ category.name|lower }}'] = '{{ category.id }}';
            {% if category.name|lower == 'chiens' %}
                categoryMapping['chiens'] = '{{ category.id }}';
            {% elseif category.name|lower == 'chats' %}
                categoryMapping['chats'] = '{{ category.id }}';
            {% elseif category.name|lower == 'oiseaux' %}
                categoryMapping['oiseaux'] = '{{ category.id }}';
            {% elseif category.name|lower in ['lézards', 'lezards'] %}
                categoryMapping['lezards'] = '{{ category.id }}';
            {% endif %}
        {% endfor %}
        
        {% for category in categories %}
            {% set categorySlug = category.name|lower == 'lézards' ? 'lezards' : category.name|lower %}
            subcategoryMapping['{{ categorySlug }}'] = {};
            {% for subCategory in category.subCategories %}
                {% set subSlug = subCategory.name|lower|replace({' ': '-', '&': '', 'à': 'a'}) %}
                subcategoryMapping['{{ categorySlug }}']['{{ subSlug }}'] = '{{ subCategory.id }}';
                
                {# Ajouter des alias pour les sous-catégories courantes #}
                {% if 'laisses' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['laisses-colliers'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'os' in subCategory.name|lower and 'jouets' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['os-jouets'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['jouets'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'croquettes' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['croquettes'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['alimentation'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'gamelles' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['gamelles-accessoires'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['accessoires'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['habitat'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'vêtements' in subCategory.name|lower or 'vetements' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['vetements'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['vêtements-pour-chiens'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['vetements-pour-chiens'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'soins' in subCategory.name|lower and 'hygiène' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['soins-hygiene'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['hygiene'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'friandises' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['friandises'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'litières' in subCategory.name|lower or 'litieres' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['litieres-bacs'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'herbe' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['herbe-chat'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'arbres' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['arbres-chat'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['arbres'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'graines' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['graines-alimentation'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['alimentation'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'cages' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['cages-volieres'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['cages'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'perchoirs' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['perchoirs'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'jouets' in subCategory.name|lower and 'accessoires' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['jouets-accessoires'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['jouets'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['accessoires'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'vitamines' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['soins-vitamines'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['soins'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'nids' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['nids-reproduction'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'chauffage' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['chauffage-uv'] = '{{ subCategory.id }}';
                    subcategoryMapping['{{ categorySlug }}']['chauffage'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'terrariums' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['terrariums'] = '{{ subCategory.id }}';
                {% endif %}
                {% if 'décoration' in subCategory.name|lower or 'decoration' in subCategory.name|lower %}
                    subcategoryMapping['{{ categorySlug }}']['decoration'] = '{{ subCategory.id }}';
                {% endif %}
            {% endfor %}
        {% endfor %}

        // Fonctions de correspondance slug -> ID 
        function findCategoryIdBySlug(slug) {
            return categoryMapping[slug] || null;
        }
        
        function findSubcategoryIdBySlug(categorySlug, subcategorySlug) {
            return subcategoryMapping[categorySlug]?.[subcategorySlug] || null;
        }

        // Initialiser selon la source (navbar ou accès direct)
        initializeFromNavbar();
        
        // Initialiser la page avec le filtrage approprié
        filterAndSort();
    });
    </script>

    {% endblock %}