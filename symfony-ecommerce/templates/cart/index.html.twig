{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .cart-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 2rem;
            font-family: var(--font-body);
        }

        .cart-main {
            background: var(--white);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .cart-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--cream);
            margin-bottom: 1rem;
            font-weight: 600;
            color: var(--dark-orange);
        }

        .product-item {
        display: grid;
        grid-template-columns: 80px 1fr;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--cream);
    }

        .product-item:last-child {
            border-bottom: none;
        }

        .product-image {
            width: 80px;
            height: 80px;
            background: var(--cream);
            border-radius: 8px;
            border: 2px solid var(--light-orange);
        }

        .product-details {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .product-name {
            font-weight: 600;
            color: var(--dark-orange);
            margin: 0;
        }

        .product-category {
            color: var(--primary-orange);
            font-size: 0.9rem;
            margin: 0;
        }

        .product-seller {
            color: var(--medium-gray);
            font-size: 0.85rem;
            margin: 0;
        }

        .product-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 0.5rem 0;
        }

        .product-variant {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }

        .color-indicator {
            width: 12px;
            height: 12px;
            background: var(--primary-orange);
            border-radius: 50%;
        }

        .quantity-display {
            padding: 0.3rem 0.8rem;
            background: var(--cream);
            border-radius: 4px;
            font-weight: 600;
            color: var(--dark-orange);
        }

        .action-button {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0.3rem;
            border-radius: 4px;
            transition: background-color 0.3s;
        }

        .action-button:hover {
            background: var(--cream);
        }

        .action-button.delete {
            color: #dc3545;
            font-size: 1.1rem;
        }

        .action-button.delete:hover {
            background: #ffebee;
            color: #c62828;
        }

        .product-price {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .price-current {
            font-weight: 700;
            color: var(--dark-orange);
            font-size: 1.1rem;
        }

        .price-old {
            text-decoration: line-through;
            color: var(--medium-gray);
            font-size: 0.9rem;
        }

        .cart-sidebar {
            background: var(--white);
            border-radius: 12px;
            padding: 1.5rem;
            height: fit-content;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border: 2px solid var(--light-orange);
        }

        .cart-summary-title {
            color: var(--dark-orange);
            font-family: var(--font-heading);
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.75rem;
            color: var(--dark-gray);
        }

        .summary-divider {
            border: none;
            border-top: 2px solid var(--cream);
            margin: 1rem 0;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--dark-orange);
            margin-bottom: 1.5rem;
        }

        .checkout-button {
            width: 90%;
            background: var(--primary-orange);
            color: var(--white);
            border: none;
            padding: 1rem;
            border-radius: 8px;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-bottom: 1.5rem;
        }

        .checkout-button:hover {
            background: var(--secondary-orange);
        }

        .payment-methods {
            text-align: center;
        }

        .payment-methods p {
            color: var(--medium-gray);
            font-size: 0.8rem;
            margin-bottom: 0.5rem;
        }

        /* Messages flash */
        .flash-message {
            padding: 1rem;
            border-radius: 8px;
            margin: 1rem auto 2rem auto;
            max-width: 1200px;
            font-weight: 500;
        }

        .flash-success {
            background-color: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }

        .flash-error {
            background-color: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }

        .empty-cart {
            text-align: center;
            padding: 3rem;
            color: var(--medium-gray);
        }

        .quantity-select {
            padding: 0.3rem 0.6rem;
            border: 1px solid var(--light-orange);
            border-radius: 4px;
            background: var(--white);
            color: var(--dark-orange);
            font-size: 0.9rem;
            cursor: pointer;
        }

        .quantity-select:focus {
            outline: none;
            border-color: var(--primary-orange);
        }

        .action-button.delete {
            color: #dc3545;
            font-size: 1.1rem;
        }

        .action-button.delete:hover {
            background: #ffebee;
            color: #c62828;
        }

        .product-controls form {
            margin: 0;
        }

        .product-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .btn {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            transition: background-color 0.3s;
        }

        .btn-primary {
            background: var(--primary-orange);
            color: var(--white);
        }

        .btn-primary:hover {
            background: var(--secondary-orange);
        }

        .btn-secondary {
            background: var(--cream);
            color: var(--dark-orange);
            position: relative;
        }

        .btn-secondary:hover {
            background: var(--light-orange);
        }

        .cart-icon {
            width: 1.2rem;
            height: 1.2rem;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        /* Responsivité */
        @media (max-width: 1400px) {
            .cart-container {
                grid-template-columns: 1fr 320px;
                gap: 1.5rem;
            }
        }

        @media (max-width: 1200px) {
            .cart-container {
                max-width: 100%;
                padding: 0 20px;
                grid-template-columns: 1fr 300px;
                gap: 20px;
            }
            
            .cart-main {
                padding: 20px;
            }
            
            .cart-sidebar {
                padding: 20px;
            }
        }

        @media (max-width: 1024px) {
            .cart-container {
                grid-template-columns: 1fr 280px;
                gap: 15px;
                padding: 0 15px;
            }
            
            .product-item {
                grid-template-columns: 70px 1fr;
                gap: 12px;
            }
            
            .product-image {
                width: 70px;
                height: 70px;
            }
        }

        @media (max-width: 900px) {
            .cart-container {
                grid-template-columns: 1fr;
                gap: 20px;
                margin: 1rem auto;
            }
            
            .cart-sidebar {
                order: -1;
                position: sticky;
                top: 20px;
                z-index: 10;
                margin-bottom: 10px;
            }
            
            .cart-summary-title {
                font-size: 1.3rem;
                margin-bottom: 1rem;
            }
            
            .summary-row {
                font-size: 14px;
                margin-bottom: 8px;
            }
            
            .summary-total {
                font-size: 1.1rem;
                margin-bottom: 1rem;
            }
            
            .checkout-button {
                padding: 12px;
                font-size: 1rem;
                margin-bottom: 1rem;
            }
        }

        @media (max-width: 768px) {
            .cart-container {
                padding: 0 12px;
                margin: 0.5rem auto;
            }
            
            .cart-main {
                padding: 15px;
                border-radius: 8px;
            }
            
            .cart-sidebar {
                padding: 15px;
                border-radius: 8px;
            }
            
            .cart-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
                font-size: 14px;
            }
            
            .product-item {
                grid-template-columns: 60px 1fr;
                gap: 10px;
                padding: 12px 0;
            }
            
            .product-image {
                width: 60px;
                height: 60px;
            }
            
            .product-name {
                font-size: 14px;
                line-height: 1.3;
            }
            
            .product-seller,
            .product-category {
                font-size: 12px;
            }
            
            .product-controls {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }
            
            .product-variant {
                flex-wrap: wrap;
                gap: 8px;
            }
            
            .quantity-select {
                padding: 6px 8px;
                font-size: 12px;
            }
            
            .product-price {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
                margin-top: 8px;
            }
            
            .price-current {
                font-size: 16px;
            }
            
            .price-old {
                font-size: 12px;
            }
        }

        @media (max-width: 640px) {
            .cart-container {
                padding: 0 8px;
                margin: 0.5rem auto;
            }
            
            .cart-main,
            .cart-sidebar {
                padding: 12px;
            }
            
            .product-item {
                grid-template-columns: 50px 1fr;
                gap: 8px;
                padding: 10px 0;
            }
            
            .product-image {
                width: 50px;
                height: 50px;
            }
            
            .cart-header {
                font-size: 13px;
            }
            
            .product-name {
                font-size: 13px;
            }
            
            .product-seller,
            .product-category {
                font-size: 11px;
            }
            
            .checkout-button {
                padding: 10px;
                font-size: 14px;
                width: 100%;
            }
            
            .flash-message {
                margin: 0.5rem auto 1rem auto;
                padding: 12px;
                font-size: 14px;
            }
        }

        @media (max-width: 480px) {
            .cart-container {
                padding: 0 6px;
                margin: 0.3rem auto;
            }
            
            .cart-main,
            .cart-sidebar {
                padding: 10px;
                border-radius: 6px;
            }
            
            .product-item {
                grid-template-columns: 45px 1fr;
                gap: 6px;
                padding: 8px 0;
            }
            
            .product-image {
                width: 45px;
                height: 45px;
            }
            
            .cart-header {
                padding-bottom: 8px;
                margin-bottom: 8px;
                font-size: 12px;
            }
            
            .product-name {
                font-size: 12px;
                margin-bottom: 2px;
            }
            
            .product-seller {
                font-size: 10px;
                margin-bottom: 6px;
            }
            
            .product-controls {
                gap: 6px;
            }
            
            .quantity-select {
                padding: 4px 6px;
                font-size: 11px;
            }
            
            .action-button {
                padding: 4px;
                font-size: 12px;
            }
            
            .product-price {
                gap: 2px;
                margin-top: 6px;
            }
            
            .price-current {
                font-size: 14px;
            }
            
            .price-old {
                font-size: 10px;
            }
            
            .cart-summary-title {
                font-size: 1.1rem;
                margin-bottom: 12px;
            }
            
            .summary-row {
                font-size: 12px;
                margin-bottom: 6px;
            }
            
            .summary-total {
                font-size: 14px;
                margin-bottom: 12px;
            }
            
            .checkout-button {
                padding: 8px;
                font-size: 13px;
            }
            
            .payment-methods p {
                font-size: 10px;
            }
            
            .empty-cart {
                padding: 1.5rem;
            }
            
            .empty-cart p:first-child {
                font-size: 1.2rem;
            }
        }

        @media (max-width: 360px) {
            .cart-container {
                padding: 0 4px;
                margin: 0.2rem auto;
            }
            
            .cart-main,
            .cart-sidebar {
                padding: 8px;
            }
            
            .product-item {
                grid-template-columns: 40px 1fr;
                gap: 6px;
                padding: 6px 0;
            }
            
            .product-image {
                width: 40px;
                height: 40px;
            }
            
            .cart-header {
                font-size: 11px;
                padding-bottom: 6px;
                margin-bottom: 6px;
            }
            
            .product-name {
                font-size: 11px;
                margin-bottom: 1px;
            }
            
            .product-seller {
                font-size: 9px;
                margin-bottom: 4px;
            }
            
            .product-controls {
                gap: 4px;
            }
            
            .quantity-select {
                padding: 3px 4px;
                font-size: 10px;
            }
            
            .price-current {
                font-size: 13px;
            }
            
            .cart-summary-title {
                font-size: 1rem;
                margin-bottom: 10px;
            }
            
            .summary-row {
                font-size: 11px;
                margin-bottom: 5px;
            }
            
            .summary-total {
                font-size: 13px;
                margin-bottom: 10px;
            }
            
            .checkout-button {
                padding: 7px;
                font-size: 12px;
            }
            
            .flash-message {
                margin: 0.3rem auto 0.8rem auto;
                padding: 8px;
                font-size: 12px;
            }
        }
    </style>
{% endblock %}

{% block body %}
{# Messages flash #}
{% for message in app.flashes('success') %}
    <div class="flash-message flash-success">
        ✅ {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="flash-message flash-error">
        ⚠️ {{ message }}
    </div>
{% endfor %}

<section class="cart-container">
  <div class="cart-main">
    <div class="cart-header">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <label for="checkAll">TOUS LES ARTICLES ({{ cartItems|length }})</label>
      </div>
      {% if cartItems|length > 0 %}
        <a href="{{ path('app_cart_clear') }}" 
           onclick="return confirm('Êtes-vous sûr de vouloir vider complètement le panier ?')"
           style="color: var(--primary-orange); text-decoration: none; font-size: 0.9rem; font-weight: 600;">
          🗑️ Vider le panier
        </a>
      {% endif %}
    </div>

    {% if cartItems is empty %}
        <div class="empty-cart">
            <p style="font-size: 1.5rem;">🐾 Votre panier est vide</p>
            <p>Découvrez nos produits pour vos animaux !</p>
            <a href="{{ path('products') }}" style="color: var(--primary-orange); text-decoration: none; padding: 0.5rem 1rem; border: 2px solid var(--primary-orange); border-radius: 6px; display: inline-block; margin-top: 1rem;">
                🛍️ Continuer mes achats
            </a>
        </div>
    {% else %}
        {% for item in cartItems %}
          <div class="product-item">
            <div class="product-image">

                <img src="{{ asset('assets/images/' ~ item.product.imageUrl) }}" 
                     alt="{{ item.product.name }}" 
                     style="width: 100%; height: 100%; object-fit: cover; border-radius: 6px;"
                     onerror="this.src='{{ asset('assets/images/hero-image.png') }}'">

            </div>

            <div class="product-details">
              <p class="product-name">{{ item.product.name }}</p>
              <p class="product-seller">Vendu par notre animalerie</p>

              <div class="product-controls">
                <div class="product-variant">
                  <span class="color-indicator"></span>
                  
                  {# Formulaire pour changer la quantité #}
                  <form action="{{ path('app_cart_update_quantity', {id: item.product.id}) }}" method="POST" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                    <label style="font-weight: 600;">Quantité:</label>
                    <select name="quantity" onchange="this.form.submit()" class="quantity-select">
                      {% for i in 1..10 %}
                        <option value="{{ i }}" {% if i == item.quantity %}selected{% endif %}>{{ i }}</option>
                      {% endfor %}
                    </select>
                  </form>
                </div>
                
                {# Formulaire pour supprimer #}
                <form action="{{ path('app_cart_remove', {id: item.product.id}) }}" method="POST" style="display: inline;">
                    <button type="submit" title="Supprimer" class="action-button delete" 
                            onclick="return confirm('Supprimer {{ item.product.name|escape('js') }} du panier ?')">
                        🗑️
                    </button>
                </form>
              </div>

              <div class="product-price">
                <span class="price-current">{{ item.prix_unitaire|number_format(2, ',', ' ') }}€</span>
                {% if item.product.price != item.prix_unitaire %}
                  <span class="price-old">{{ item.product.price|number_format(2, ',', ' ') }}€</span>
                {% endif %}
                <span style="color: var(--medium-gray); margin-left: 1rem;">
                    Total: {{ item.total_ligne|number_format(2, ',', ' ') }}€
                </span>
              </div>
            </div>
          </div>
        {% endfor %}
    {% endif %}
  </div>

  <aside class="cart-sidebar">
    <h2 class="cart-summary-title">Résumé de votre commande</h2>

    <div class="summary-row">
      <span>Sous-total HT :</span>
      <span>{{ totalHT|number_format(2, ',', ' ') }}€</span>
    </div>

    <div class="summary-row">
      <span>TVA ({{ tauxTVA }}%) :</span>
      <span>{{ montantTVA|number_format(2, ',', ' ') }}€</span>
    </div>

    <div class="summary-row">
      <span>Livraison :</span>
      <span style="color: var(--primary-orange); " >{% if fraisLivraison == 0 %}Gratuite{% else %}{{ fraisLivraison|number_format(2, ',', ' ') }}€{% endif %}</span>
    </div>

    <hr class="summary-divider">

    <div class="summary-total">
      <span>Total TTC :</span>
<span>
  {% if totalFinal > 0 %}
    {{ totalFinal|number_format(2, ',', ' ') }}€
  {% else %}
    0,00€
  {% endif %}
</span>
    </div>

    {% if cartItems|length > 0 %}
        <a href="{{ path('app_cart_checkout') }}" class="checkout-button" style="text-decoration: none; display: block; text-align: center;">
          Passer au paiement ({{ cartItems|length }})
        </a>
    {% else %}
        <button class="checkout-button" disabled style="background: var(--medium-gray); cursor: not-allowed;">
          Panier vide
        </button>
    {% endif %}

    <div class="payment-methods">
      <p>NOUS ACCEPTONS</p>
      <p style="background: var(--cream); padding: 0.5rem; border-radius: 4px;">
        💳 CB • PayPal 
      </p>
    </div>

    {% if totalPanier > 0 and totalPanier < 200 %}
        <div style="background: var(--light-orange); padding: 1rem; border-radius: 8px; margin-top: 1rem; text-align: center;">
            <p style="margin: 0; color: var(--dark-orange); font-weight: 600;">
                🚚 Plus que {{ (200 - totalPanier)|number_format(2, ',', ' ') }}€ pour la livraison gratuite !
            </p>
        </div>
    {% endif %}
  </aside>
</section>
{% endblock %}