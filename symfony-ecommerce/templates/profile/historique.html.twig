{% extends 'base.html.twig' %}
{% block robots %}noindex, nofollow{% endblock %}

{% block title %}Historique des commandes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .historique-container {
            max-width: 1000px;
            margin: 2rem auto;
            padding: 2rem;
            background: var(--cream);
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }
        
        .page-title {
            font-family: var(--font-heading);
            color: var(--primary-orange);
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .orders-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .order-item {
            background: var(--white);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
            border-left: 4px solid var(--primary-orange);
            transition: all 0.3s ease;
        }
        
        .order-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(251, 150, 41, 0.15);
        }
        
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .order-number {
            font-family: var(--font-heading);
            font-size: 1.3rem;
            color: var(--dark-gray);
            font-weight: 600;
        }
        
        .order-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .detail-item {
            display: flex;
            align-items: center;
            color: var(--medium-gray);
        }
        
        .detail-item i {
            color: var(--primary-orange);
            margin-right: 0.5rem;
            width: 20px;
        }
        
        .detail-value {
            font-weight: 600;
            color: var(--dark-gray);
            margin-left: 0.5rem;
        }
        
        .order-total {
            color: var(--primary-orange);
            font-size: 1.2rem;
            font-weight: 700;
        }
        
        .btn-detail {
            background: var(--primary-orange);
            color: var(--white);
            text-decoration: none;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .btn-detail:hover {
            background: var(--secondary-orange);
            color: var(--white);
            text-decoration: none;
            transform: translateY(-1px);
        }
        
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            background: var(--white);
            border-radius: 12px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
        }
        
        .empty-icon {
            font-size: 4rem;
            color: var(--light-orange);
            margin-bottom: 1rem;
        }
        
        .empty-title {
            font-family: var(--font-heading);
            color: var(--dark-gray);
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }
        
        .empty-text {
            color: var(--medium-gray);
            margin-bottom: 2rem;
        }
        
        .btn-shop {
            background: var(--primary-orange);
            color: var(--white);
            text-decoration: none;
            padding: 1rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-shop:hover {
            background: var(--secondary-orange);
            color: var(--white);
            text-decoration: none;
            transform: translateY(-2px);
        }

        .link-orders-section {
            background: var(--white);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
            border-left: 4px solid var(--secondary-orange);
        }

        .link-orders-title {
            font-family: var(--font-heading);
            color: var(--dark-gray);
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
        }

        .link-orders-description {
            color: var(--medium-gray);
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .btn-link-orders {
            background: var(--secondary-orange);
            color: var(--white);
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-link-orders:hover {
            background: var(--dark-orange);
            color: var(--white);
            text-decoration: none;
            transform: translateY(-1px);
        }
        
        @media (max-width: 768px) {
            .historique-container {
                margin: 1rem;
                padding: 1rem;
            }
            
            .order-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
            
            .order-details {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="historique-container">
        <h1 class="page-title">
            <i class="fas fa-shopping-bag"></i>
            Mes commandes
        </h1>

        {% if orders is empty %}
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <h2 class="empty-title">Aucune commande</h2>
                <p class="empty-text">Vous n'avez encore passé aucune commande.</p>
                <a href="{{ path('homepage') }}" class="btn-shop">
                    <i class="fas fa-paw"></i>
                    Découvrir nos produits
                </a>
            </div>
        {% else %}
            <ul class="orders-list">
                {% for order in orders %}
                    <li class="order-item">
                        <div class="order-header">
                            <div class="order-number">
                                <i class="fas fa-receipt"></i>
                                Commande #{{ order.id }}
                            </div>
                        </div>
                        
                        <div class="order-details">
                            <div class="detail-item">
                                <i class="fas fa-calendar-alt"></i>
                                Date : <span class="detail-value">{{ order.createdAt|date('d/m/Y à H:i') }}</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-info-circle"></i>
                                Statut : <span class="detail-value">{{ order.status }}</span>
                            </div>
                            <div class="detail-item">
                                <i class="fas fa-euro-sign"></i>
                                Total : <span class="detail-value order-total">{{ order.total|number_format(2, ',', ' ') }} €</span>
                            </div>
                        </div>

                        <a href="{{ path('app_historique_detail', { id: order.id }) }}" class="btn-detail">
                            <i class="fas fa-eye"></i>
                            Voir les détails
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
