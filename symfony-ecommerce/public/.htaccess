# Use the front controller as index file
DirectoryIndex index.php

# Disable MultiViews
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# Cache statique : 1 an pour les assets (images, CSS, fonts)
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Déterminer RewriteBase automatiquement
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Restaurer Authorization pour les API
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%0]

    # Rediriger /index.php vers /
    RewriteCond %{THE_REQUEST} \s/index\.php [NC]
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,END,L]

    # Si le fichier existe, le servir directement
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>
